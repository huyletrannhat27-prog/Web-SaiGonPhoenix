<% layout('layout') -%>
<section class="profile-page">
    <header class="profile-hero">
        <div class="profile-avatar" aria-hidden="true"><%= (form.username || 'K').trim().charAt(0).toUpperCase() %></div>
        <div><span class="profile-eyebrow"><i class="fa-solid fa-user-shield"></i> <span data-i18n="account_center">Trung tâm tài khoản</span></span><h1 data-i18n="my_account">Tài khoản của tôi</h1><p data-i18n="profile_intro">Xem và cập nhật thông tin để việc đặt xe nhanh, chính xác hơn.</p></div>
        <div class="profile-completion"><div class="profile-completion-ring" style="--completion:<%= completion %>%"><strong><%= completion %>%</strong></div><span data-i18n="profile_completion">Hồ sơ hoàn thiện</span></div>
    </header>

    <div class="profile-layout">
        <aside class="profile-summary">
            <div class="profile-summary-icon"><i class="fa-solid fa-circle-check"></i></div>
            <h2 data-i18n="account_secure">Tài khoản được bảo vệ</h2>
            <p data-i18n="account_secure_hint">Bạn chỉ có thể thay đổi thông tin của chính mình. Đổi email cần xác nhận mật khẩu hiện tại.</p>
            <dl>
                <div><dt data-i18n="account_role">Loại tài khoản</dt><dd><%= ({ user: 'Khách hàng', driver: 'Tài xế', admin: 'Quản trị viên' })[user.role] || user.role %></dd></div>
                <div><dt data-i18n="member_since">Thành viên từ</dt><dd><%= new Date(user.createdAt).toLocaleDateString('vi-VN') %></dd></div>
            </dl>
            <a href="/dashboard" class="profile-trips-link"><i class="fa-solid fa-car-side"></i> <span data-i18n="my_trips">Chuyến của tôi</span></a>
        </aside>

        <form class="profile-form form-card" method="post" action="/profile" novalidate>
            <div class="profile-form-heading"><div><span class="profile-section-icon"><i class="fa-solid fa-id-card"></i></span><h2 data-i18n="personal_information">Thông tin cá nhân</h2><p data-i18n="personal_information_hint">Các trường có dấu * là thông tin cần thiết cho đơn đặt xe.</p></div></div>
            <% if (error) { %><div class="alert alert-danger"><i class="fa-solid fa-circle-exclamation me-2"></i><%= error %></div><% } %>
            <div class="profile-fields">
                <label class="modern-field"><span><b>*</b> <span data-i18n="full_name">Họ và tên</span></span><div><i class="fa-regular fa-user"></i><input name="username" maxlength="80" value="<%= form.username %>" autocomplete="name" required data-i18n-placeholder="full_name_placeholder" placeholder="Nhập họ và tên"></div></label>
                <label class="modern-field"><span><b>*</b> Email</span><div><i class="fa-regular fa-envelope"></i><input type="email" name="email" maxlength="120" value="<%= form.email %>" autocomplete="email" required placeholder="ban@example.com"></div></label>
                <label class="modern-field"><span><b>*</b> <span data-i18n="phone_number">Số điện thoại</span></span><div><i class="fa-solid fa-phone"></i><input type="tel" name="phone" maxlength="30" value="<%= form.phone %>" autocomplete="tel" required data-i18n-placeholder="phone_placeholder" placeholder="Ví dụ: 0901 234 567"></div></label>
                <label class="modern-field"><span data-i18n="date_of_birth">Ngày sinh</span><div><i class="fa-regular fa-calendar"></i><input type="date" name="dateOfBirth" value="<%= form.dateOfBirth %>" autocomplete="bday"></div></label>
                <label class="modern-field"><span data-i18n="gender">Giới tính</span><div><i class="fa-solid fa-venus-mars"></i><select name="gender"><option value="" data-i18n="not_specified">Không muốn nêu</option><option value="male" <%= form.gender === 'male' ? 'selected' : '' %> data-i18n="male">Nam</option><option value="female" <%= form.gender === 'female' ? 'selected' : '' %> data-i18n="female">Nữ</option><option value="other" <%= form.gender === 'other' ? 'selected' : '' %> data-i18n="other">Khác</option></select></div></label>
                <label class="modern-field"><span data-i18n="city">Tỉnh / Thành phố</span><div><i class="fa-solid fa-city"></i><input name="city" maxlength="100" value="<%= form.city %>" autocomplete="address-level1" data-i18n-placeholder="city_placeholder" placeholder="Ví dụ: Hồ Chí Minh"></div></label>
                <label class="modern-field"><span data-i18n="country">Quốc gia</span><div><i class="fa-solid fa-earth-asia"></i><input name="country" maxlength="100" value="<%= form.country %>" autocomplete="country-name" data-i18n-placeholder="country_placeholder" placeholder="Ví dụ: Việt Nam"></div></label>
                <label class="modern-field profile-field-wide"><span data-i18n="address">Địa chỉ</span><div><i class="fa-solid fa-location-dot"></i><input name="address" maxlength="250" value="<%= form.address %>" autocomplete="street-address" data-i18n-placeholder="address_placeholder" placeholder="Số nhà, đường, phường/xã..."></div></label>
            </div>

            <div class="profile-divider"><span data-i18n="emergency_contact">Liên hệ khẩn cấp</span></div>
            <p class="profile-section-hint" data-i18n="emergency_contact_hint">Dùng khi cần hỗ trợ gấp trong hành trình; thông tin này không hiển thị công khai.</p>
            <div class="profile-fields">
                <label class="modern-field"><span data-i18n="emergency_contact_name">Tên người liên hệ</span><div><i class="fa-regular fa-user"></i><input name="emergencyContactName" maxlength="100" value="<%= form.emergencyContactName %>" autocomplete="off" data-i18n-placeholder="emergency_contact_name_placeholder" placeholder="Họ và tên người liên hệ"></div></label>
                <label class="modern-field"><span data-i18n="emergency_contact_phone">Số điện thoại liên hệ</span><div><i class="fa-solid fa-phone-volume"></i><input type="tel" name="emergencyContactPhone" maxlength="30" value="<%= form.emergencyContactPhone %>" autocomplete="off" data-i18n-placeholder="emergency_contact_phone_placeholder" placeholder="Ví dụ: 0901 234 567"></div></label>
            </div>

            <div class="profile-security-note"><i class="fa-solid fa-lock"></i><span data-i18n="email_change_hint">Chỉ cần nhập mật khẩu hiện tại nếu bạn thay đổi email.</span></div>
            <label class="modern-field profile-current-password"><span data-i18n="current_password">Mật khẩu hiện tại</span><div><i class="fa-solid fa-key"></i><input type="password" name="currentPassword" autocomplete="current-password" data-i18n-placeholder="current_password_placeholder" placeholder="Nhập để xác nhận khi đổi email"><button type="button" class="password-toggle" data-password-toggle aria-label="Hiện mật khẩu"><i class="fa-regular fa-eye"></i></button></div></label>
            <div class="profile-actions"><a href="/dashboard" class="btn btn-light" data-i18n="cancel">Hủy</a><button type="submit" class="btn btn-hero"><i class="fa-solid fa-floppy-disk"></i> <span data-i18n="save_profile">Lưu thông tin</span></button></div>
        </form>
    </div>
</section>
