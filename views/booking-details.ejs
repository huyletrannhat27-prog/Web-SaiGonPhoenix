<% layout('layout') -%>
<% const vehicleName = booking.vehicle?.name || booking.vehicleSnapshot?.name || 'Xe đã xóa'; const vehicleImage = booking.vehicle?.images?.[0] || booking.vehicleSnapshot?.image || '/images/default-car.jpg'; const paymentLabels = {awaiting_payment:'Chờ thanh toán',pending_review:'Chờ admin kiểm tra',partial:'Đã đặt cọc',paid:'Đã thanh toán đủ'}; %>
<div class="form-card"><div class="card-header"><h4>Đơn #<%= booking._id.toString().slice(-8).toUpperCase() %></h4><p>Tạo lúc <%= new Date(booking.createdAt).toLocaleString('vi-VN') %></p></div><div class="card-body">
<div class="row g-4"><div class="col-md-5"><img class="img-fluid rounded" src="<%= vehicleImage %>" alt="<%= vehicleName %>"><h4 class="mt-3"><%= vehicleName %></h4><div class="fs-4 text-danger fw-bold"><%= booking.totalPrice.toLocaleString('vi-VN') %>đ</div></div>
<div class="col-md-7"><span class="status status-<%= booking.status %>"><%= ({pending:'Chờ xác nhận',confirmed:'Đã xác nhận',completed:'Hoàn thành',cancelled:'Đã hủy'})[booking.status] %></span><dl class="row mt-4"><dt class="col-sm-4">Khách hàng</dt><dd class="col-sm-8"><%= booking.customerInfo.name %> · <%= booking.customerInfo.phone %></dd><dt class="col-sm-4">Thời gian</dt><dd class="col-sm-8"><%= new Date(booking.bookingDate).toLocaleString('vi-VN') %></dd><dt class="col-sm-4">Sân bay</dt><dd class="col-sm-8"><%= booking.airport %></dd><dt class="col-sm-4">Hành trình</dt><dd class="col-sm-8"><%= booking.customerInfo.pickupLocation %> → <%= booking.customerInfo.dropoffLocation %></dd><dt class="col-sm-4">Khách / hành lý</dt><dd class="col-sm-8"><%= booking.customerInfo.passengerCount %> / <%= booking.customerInfo.luggageCount %></dd><dt class="col-sm-4">Chuyến bay</dt><dd class="col-sm-8"><%= booking.customerInfo.flightNumber || 'Không có' %></dd><dt class="col-sm-4">Ghi chú</dt><dd class="col-sm-8"><%= booking.note || 'Không có' %></dd></dl></div></div>
<hr class="my-4"><div class="row g-4 align-items-start"><div class="col-md-6"><h4><i class="fas fa-building-columns text-danger"></i> Thanh toán chuyển khoản</h4><div class="bank-box mt-3"><div class="d-flex justify-content-between mb-2"><span>Trạng thái</span><strong><%= paymentLabels[booking.payment.status] %></strong></div><div class="d-flex justify-content-between mb-2"><span>Đã nhận</span><strong><%= booking.payment.paidAmount.toLocaleString('vi-VN') %>đ</strong></div><div class="d-flex justify-content-between mb-3"><span>Cần chuyển lúc này</span><strong class="text-danger fs-5"><%= amountDue.toLocaleString('vi-VN') %>đ</strong></div>
<% if (bank?.accountNo) { %><hr><p class="mb-1"><small>Ngân hàng</small><br><strong><%= bank.bankName %></strong></p><p class="mb-1"><small>Số tài khoản</small><br><strong class="fs-5"><%= bank.accountNo %></strong></p><p class="mb-1"><small>Chủ tài khoản</small><br><strong><%= bank.accountName %></strong></p><p class="mb-0"><small>Nội dung bắt buộc</small><br><strong class="text-danger"><%= transferContent %></strong></p><% } else { %><div class="alert alert-warning mb-0">Admin chưa cấu hình tài khoản ngân hàng.</div><% } %></div>
<% if (session.role !== 'admin' && ['awaiting_payment','partial'].includes(booking.payment.status) && bank?.accountNo) { %><form class="mt-3" method="post" action="/bookings/<%= booking._id %>/payment-submitted"><button class="btn btn-danger w-100" onclick="return confirm('Bạn xác nhận đã chuyển khoản đúng số tiền và nội dung?')">Tôi đã chuyển khoản</button></form><% } %>
<% if (booking.payment.status === 'pending_review') { %><div class="alert alert-info mt-3">Thông báo đã gửi. Vui lòng chờ admin đối soát tài khoản.</div><% } %></div>
<div class="col-md-6 text-center"><% if (qrUrl && !['paid','pending_review'].includes(booking.payment.status)) { %><h5>Quét bằng ứng dụng ngân hàng</h5><img class="qr-payment" src="<%= qrUrl %>" alt="VietQR thanh toán"><p class="small text-muted mt-2">QR đã điền sẵn số tiền và nội dung chuyển khoản.</p><a class="btn btn-outline-dark" href="<%= qrUrl %>" target="_blank" rel="noopener">Mở mã QR kích thước lớn</a><% } else if (booking.payment.status === 'paid') { %><div class="py-5 text-success"><i class="fas fa-circle-check fa-5x"></i><h4 class="mt-3">Đã thanh toán đủ</h4></div><% } %></div></div>
<% if (booking.status === 'pending' && session.role !== 'admin') { %><hr><form method="post" action="/bookings/<%= booking._id %>/cancel" onsubmit="return confirm('Bạn chắc chắn muốn hủy đơn?')"><button class="btn btn-outline-danger">Hủy đơn</button></form><% } %></div></div>
