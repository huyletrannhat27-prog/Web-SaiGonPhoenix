<% layout('layout') -%>
<% const vehicleName = booking.vehicle?.name || booking.vehicleSnapshot?.name || 'Xe đã xóa'; const vehicleImage = booking.vehicle?.images?.[0] || booking.vehicleSnapshot?.image || '/images/default-car.jpg'; const paymentLabels = {awaiting_payment:'Chờ thanh toán',pending_review:'Chờ admin kiểm tra',partial:'Đã đặt cọc',paid:'Đã thanh toán đủ'}; const statusLabels = {pending:'Chờ xác nhận',confirmed:'Chờ phục vụ',completed:'Hoàn thành',cancelled:'Đã hủy',expired:'Quá hạn'}; %>
<div class="form-card"><div class="card-header"><h4><span data-i18n="booking_number">Đơn</span> #<%= booking._id.toString().slice(-8).toUpperCase() %></h4><p><span data-i18n="created_at">Tạo lúc</span> <%= new Date(booking.createdAt).toLocaleString('vi-VN') %></p></div><div class="card-body">
<div class="row g-4"><div class="col-md-5"><img class="img-fluid rounded" src="<%= vehicleImage %>" alt="<%= vehicleName %>"><h4 class="mt-3"><%= vehicleName %></h4><div class="fs-4 text-danger fw-bold"><%= booking.totalPrice.toLocaleString('vi-VN') %>đ</div></div>
<div class="col-md-7"><span class="status status-<%= booking.status %>"><%= statusLabels[booking.status] %></span><dl class="row mt-4"><dt class="col-sm-4">Khách hàng</dt><dd class="col-sm-8"><%= booking.customerInfo.name %> · <%= booking.customerInfo.phone %></dd><dt class="col-sm-4">Thời gian đặt</dt><dd class="col-sm-8"><%= new Date(booking.bookingDate).toLocaleString('vi-VN') %></dd><dt class="col-sm-4">Sân bay</dt><dd class="col-sm-8"><%= booking.airport %></dd><dt class="col-sm-4">Hành trình</dt><dd class="col-sm-8"><%= booking.customerInfo.pickupLocation %> → <%= booking.customerInfo.dropoffLocation %></dd><dt class="col-sm-4">Khách / hành lý</dt><dd class="col-sm-8"><%= booking.customerInfo.passengerCount %> / <%= booking.customerInfo.luggageCount %></dd><dt class="col-sm-4">Chuyến bay</dt><dd class="col-sm-8"><%= booking.customerInfo.flightNumber || 'Không có' %></dd><dt class="col-sm-4">Ghi chú</dt><dd class="col-sm-8"><%= booking.note || 'Không có' %></dd></dl></div></div>
<% if (booking.tripType === 'airport-pickup' && booking.customerInfo.flightNumber) { %><section class="flight-tracking-card"><div class="flight-tracking-icon"><i class="fa-solid fa-plane-arrival"></i></div><div><span>THEO DÕI FLIGHTRADAR24</span><h4><%= booking.customerInfo.flightNumber %> · <%= booking.flightTracking?.status === 'landed' ? 'Đã hạ cánh' : booking.flightTracking?.status === 'en_route' ? 'Đang bay' : 'Đang chờ dữ liệu' %></h4><p><%= booking.flightTracking?.message || 'Hệ thống sẽ tự cập nhật khi chuyến bay bắt đầu được theo dõi.' %></p><div class="flight-times"><% if (booking.flightTracking?.estimatedArrival) { %><span><small>Giờ đáp dự kiến (ETA)</small><strong><%= new Date(booking.flightTracking.estimatedArrival).toLocaleString('vi-VN') %></strong></span><% } %><% if (booking.flightTracking?.actualTakeoff) { %><span><small>Cất cánh thực tế</small><strong><%= new Date(booking.flightTracking.actualTakeoff).toLocaleString('vi-VN') %></strong></span><% } %><% if (booking.flightTracking?.actualLanding) { %><span><small>Hạ cánh thực tế</small><strong><%= new Date(booking.flightTracking.actualLanding).toLocaleString('vi-VN') %></strong></span><% } %></div></div></section><% } %>
<% if (booking.status === 'confirmed' && (booking.assignedDriver || booking.vehicle?.driver)) { const driver = booking.assignedDriver || booking.vehicle.driver; %><section class="assigned-driver-card"><div class="driver-public-avatar"><% if (driver.driverProfile?.photo) { %><img src="<%= driver.driverProfile.photo %>" alt="<%= driver.username %>"><% } else { %><i class="fa-solid fa-user-tie"></i><% } %></div><div><span>TÀI XẾ PHỤ TRÁCH</span><h4><%= driver.username %></h4><p><%= driver.phone %><%= driver.driverProfile?.licensePlate ? ` · Biển số ${driver.driverProfile.licensePlate}` : '' %><%= driver.driverProfile?.yearsExperience ? ` · ${driver.driverProfile.yearsExperience} năm kinh nghiệm` : '' %></p></div><% if (session.role === 'user') { %><button type="button" class="btn btn-primary" data-chat-open data-chat-booking="<%= booking._id %>" data-chat-target="driver" data-chat-name="<%= driver.username %>"><i class="fa-regular fa-comments"></i> Chat với tài xế</button><% } %></section><% } %>
<hr class="my-4"><div class="row g-4 align-items-start"><div class="col-md-6"><h4><i class="fas fa-building-columns text-danger"></i> Thanh toán chuyển khoản</h4><div class="bank-box mt-3"><div class="d-flex justify-content-between mb-2"><span data-i18n="status">Trạng thái</span><strong><%= paymentLabels[booking.payment.status] %></strong></div><div class="d-flex justify-content-between mb-2"><span data-i18n="received">Đã nhận</span><strong><%= booking.payment.paidAmount.toLocaleString('vi-VN') %>đ</strong></div><div class="d-flex justify-content-between mb-3"><span data-i18n="amount_due">Cần chuyển lúc này</span><strong class="text-danger fs-5"><%= amountDue.toLocaleString('vi-VN') %>đ</strong></div>
<% if (bank?.accountNo) { %><hr><p class="mb-1"><small data-i18n="bank">Ngân hàng</small><br><strong><%= bank.bankName %></strong></p><p class="mb-1"><small data-i18n="account_number">Số tài khoản</small><br><strong class="fs-5"><%= bank.accountNo %></strong></p><p class="mb-1"><small data-i18n="account_holder">Chủ tài khoản</small><br><strong><%= bank.accountName %></strong></p><p class="mb-0"><small data-i18n="required_content">Nội dung bắt buộc</small><br><strong class="text-danger"><%= transferContent %></strong></p><% } else { %><div class="alert alert-warning mb-0">Admin chưa cấu hình tài khoản ngân hàng.</div><% } %></div>
<% if (session.role !== 'admin' && ['awaiting_payment','partial'].includes(booking.payment.status) && bank?.accountNo) { %><form class="mt-3" method="post" action="/bookings/<%= booking._id %>/payment-submitted"><button class="btn btn-danger w-100" onclick="return confirm('Bạn xác nhận đã chuyển khoản đúng số tiền và nội dung?')" data-i18n="paid_transfer">Tôi đã chuyển khoản</button></form><% } %>
<% if (booking.payment.status === 'pending_review') { %><div class="alert alert-info mt-3">Thông báo đã gửi. Vui lòng chờ admin đối soát tài khoản.</div><% } %></div>
<div class="col-md-6 text-center"><% if (qrUrl && !['paid','pending_review'].includes(booking.payment.status)) { %><h5 data-i18n="scan_bank_app">Quét bằng ứng dụng ngân hàng</h5><img class="qr-payment" src="<%= qrUrl %>" alt="VietQR thanh toán"><p class="small text-muted mt-2" data-i18n="qr_prefilled">QR đã điền sẵn số tiền và nội dung chuyển khoản.</p><a class="btn btn-outline-dark" href="<%= qrUrl %>" target="_blank" rel="noopener">Mở mã QR kích thước lớn</a><% } else if (booking.payment.status === 'paid') { %><div class="py-5 text-success"><i class="fas fa-circle-check fa-5x"></i><h4 class="mt-3" data-i18n="paid_full_status">Đã thanh toán đủ</h4></div><% } %></div></div>
<% if (booking.status === 'pending' && session.role !== 'admin') { %><hr><form method="post" action="/bookings/<%= booking._id %>/cancel" onsubmit="return confirm('Bạn chắc chắn muốn hủy đơn?')"><button class="btn btn-outline-danger" data-i18n="cancel_booking">Hủy đơn</button></form><% } %></div></div>
<% if (booking.status === 'completed' && session.role === 'user') { %><section class="completed-review-cta"><div><i class="fa-solid fa-star"></i></div><div><span>CHUYẾN ĐI ĐÃ HOÀN THÀNH</span><h3><%= review ? 'Cảm ơn bạn đã đánh giá chuyến đi' : 'Trải nghiệm chuyến đi của bạn thế nào?' %></h3><p><%= review ? `Bạn đã chấm tài xế ${review.driverRating}/5 và chuyến đi ${review.tripRating}/5.` : 'Đánh giá tài xế và chuyến đi để giúp chúng tôi phục vụ tốt hơn.' %></p></div><a class="btn <%= review ? 'btn-outline-primary' : 'btn-danger' %>" href="/bookings/<%= booking._id %>/review"><%= review ? 'Xem đánh giá' : 'Đánh giá ngay' %></a></section><% } %>
