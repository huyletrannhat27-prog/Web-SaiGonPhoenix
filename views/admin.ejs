<% layout('layout') -%>
<% const paymentLabels = {awaiting_payment:'Chờ thanh toán',pending_review:'Chờ kiểm tra',partial:'Đã cọc',paid:'Đã trả đủ'}; %>
<div class="dashboard-header"><h1><i class="fas fa-gauge-high"></i> Trung tâm quản trị</h1><p>Quản lý đơn đặt xe, thanh toán và đội xe.</p></div>
<div class="row g-3 mb-4"><% [[bookings.length,'Tổng đơn'],[vehicles.length,'Xe trong hệ thống'],[userCount,'Khách hàng']].forEach(x => { %><div class="col-md-4"><div class="stat-card"><div class="stat-number"><%= x[0] %></div><div class="stat-label"><%= x[1] %></div></div></div><% }) %></div>
<div class="form-card"><div class="card-header"><h4>Đơn đặt xe và thanh toán</h4></div><div class="card-body p-0"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Khách</th><th>Xe / chuyến</th><th>Thanh toán</th><th>Trạng thái chuyến</th><th></th></tr></thead><tbody><% bookings.forEach(b => { %><tr><td><strong><%= b.customerInfo.name %></strong><br><small><%= b.customerInfo.phone %><br><%= new Date(b.bookingDate).toLocaleString('vi-VN') %></small></td><td><%= b.vehicle?.name || b.vehicleSnapshot?.name || 'Xe đã xóa' %><br><small><%= b.customerInfo.pickupLocation %> → <%= b.customerInfo.dropoffLocation %></small></td><td><span class="badge bg-secondary"><%= paymentLabels[b.payment.status] %></span><br><small>Đã nhận: <%= b.payment.paidAmount.toLocaleString('vi-VN') %> / <%= b.totalPrice.toLocaleString('vi-VN') %>đ</small><form method="post" action="/admin/bookings/<%= b._id %>/payment" class="d-flex gap-1 mt-2"><input class="form-control form-control-sm" type="number" min="0" max="<%= b.totalPrice %>" name="paidAmount" value="<%= b.payment.status === 'partial' ? b.totalPrice : b.payment.requiredAmount %>" aria-label="Tổng tiền thực nhận"><button class="btn btn-sm btn-success">Xác nhận đủ tiền</button></form></td><td><form method="post" action="/admin/bookings/<%= b._id %>/status" class="d-flex gap-1"><select class="form-select form-select-sm" name="status"><% ['pending','confirmed','completed','cancelled'].forEach(s => { %><option value="<%= s %>" <%= b.status === s ? 'selected' : '' %>><%= ({pending:'Chờ xác nhận',confirmed:'Đã xác nhận',completed:'Hoàn thành',cancelled:'Đã hủy'})[s] %></option><% }) %></select><button class="btn btn-sm btn-dark">Lưu</button></form></td><td><a href="/bookings/<%= b._id %>" class="btn btn-sm btn-outline-dark">Xem</a></td></tr><% }) %></tbody></table></div></div></div>
<div class="form-card" id="payment-settings"><div class="card-header"><h4>Tài khoản nhận thanh toán VietQR</h4><p>QR của khách sẽ tự điền số tiền và mã đơn.</p></div><div class="card-body"><form method="post" action="/admin/payment-settings" class="row g-3"><div class="col-md-3"><label class="form-label">Mã/Tên ngân hàng</label><input class="form-control" name="bankId" value="<%= bank.bankId || '' %>" placeholder="VD: MB, VCB, 970422" required></div><div class="col-md-3"><label class="form-label">Tên ngân hàng</label><input class="form-control" name="bankName" value="<%= bank.bankName || '' %>" placeholder="MB Bank" required></div><div class="col-md-3"><label class="form-label">Số tài khoản</label><input class="form-control" name="accountNo" inputmode="numeric" value="<%= bank.accountNo || '' %>" required></div><div class="col-md-3"><label class="form-label">Tên chủ tài khoản</label><input class="form-control" name="accountName" value="<%= bank.accountName || '' %>" placeholder="NGUYEN VAN A" required></div><div class="col-12"><button class="btn btn-danger">Lưu tài khoản nhận tiền</button></div></form></div></div>
<div class="form-card" id="image-library"><div class="card-header"><h4><i class="fas fa-images"></i> Thư viện ảnh xe</h4><p>Tải ảnh một lần và sử dụng lại khi tạo nhiều loại xe.</p></div><div class="card-body"><form method="post" action="/admin/images" enctype="multipart/form-data" class="row g-2 align-items-end mb-4"><div class="col-md-9"><label class="form-label">Chọn ảnh từ máy (JPG, PNG, WEBP hoặc GIF, tối đa 5 MB)</label><input class="form-control" type="file" name="vehicleImage" accept="image/jpeg,image/png,image/webp,image/gif" required></div><div class="col-md-3"><button class="btn btn-danger w-100"><i class="fas fa-cloud-arrow-up"></i> Tải ảnh lên</button></div></form><% if (!imageAssets.length) { %><div class="text-center text-muted py-4">Thư viện chưa có ảnh nào.</div><% } else { %><div class="row g-3"><% imageAssets.forEach(image => { %><div class="col-6 col-md-3"><div class="image-library-card"><img src="<%= image.url %>" alt="<%= image.originalName %>"><div class="p-2"><small class="d-block text-truncate" title="<%= image.originalName %>"><%= image.originalName %></small><small class="text-muted"><%= (image.size / 1024).toFixed(0) %> KB</small><form method="post" action="/admin/images/<%= image._id %>/delete" onsubmit="return confirm('Xóa ảnh này khỏi thư viện?')"><button class="btn btn-sm btn-outline-danger w-100 mt-2"><i class="fas fa-trash"></i> Xóa ảnh</button></form></div></div></div><% }) %></div><% } %></div></div>
<div class="form-card" id="vehicles"><div class="card-header"><h4>Quản lý đội xe</h4></div><div class="card-body"><form method="post" action="/admin/vehicles" class="row g-2 mb-4"><div class="col-md-3"><input class="form-control" name="name" placeholder="Tên xe" required></div><div class="col-md-2"><select class="form-select" name="type"><% ['4 cho','7 cho','9 cho','9 cho vip','16 cho','29 cho','45 cho'].forEach(t => { %><option><%= t %></option><% }) %></select></div><div class="col-md-2"><input class="form-control" type="number" min="0" name="price" placeholder="Giá/lượt" required></div><div class="col-md-2"><input class="form-control" type="number" min="1" name="capacity" placeholder="Số khách" required></div><div class="col-md-3"><input class="form-control" type="number" min="0" name="luggageCapacity" placeholder="Số hành lý"></div><div class="col-md-6"><label class="form-label">Chọn từ thư viện ảnh</label><select class="form-select" name="imageAssetId" id="vehicleImageAsset"><option value="">-- Không chọn --</option><% imageAssets.forEach(image => { %><option value="<%= image._id %>" data-image-url="<%= image.url %>"><%= image.originalName %></option><% }) %></select></div><div class="col-md-6"><label class="form-label">Hoặc URL ảnh bên ngoài</label><input class="form-control" type="url" name="image" placeholder="https://..."></div><div class="col-12"><img id="vehicleImagePreview" class="admin-image-preview d-none" alt="Ảnh xe đã chọn"></div><div class="col-12"><input class="form-control" name="description" placeholder="Mô tả xe"><button class="btn btn-danger mt-2">Thêm xe</button></div></form>
<div class="row g-3"><% vehicles.forEach(v => { %><div class="col-md-6 col-lg-4"><div class="border rounded p-3"><div class="d-flex gap-3 align-items-center mb-2"><img class="vehicle-admin-thumb" src="<%= v.images[0] || '/images/default-car.jpg' %>" alt="<%= v.name %>"><div><strong><%= v.name %></strong><br><small><%= v.type %> · <%= v.price.toLocaleString('vi-VN') %>đ</small><br><span class="badge <%= v.isAvailable ? 'bg-success' : 'bg-secondary' %>"><%= v.isAvailable ? 'Đang hoạt động' : 'Đã ẩn' %></span></div></div><div class="d-flex gap-2 mt-3 flex-wrap"><a class="btn btn-sm btn-primary" href="/admin/vehicles/<%= v._id %>/edit"><i class="fas fa-pen"></i> Chỉnh sửa</a><form method="post" action="/admin/vehicles/<%= v._id %>/toggle"><button class="btn btn-sm btn-outline-dark"><%= v.isAvailable ? 'Ẩn xe' : 'Hiện xe' %></button></form><form method="post" action="/admin/vehicles/<%= v._id %>/delete" onsubmit="return confirm('Xóa vĩnh viễn xe <%= v.name %>? Thao tác này không thể hoàn tác.')"><button class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i> Xóa hẳn</button></form></div></div></div><% }) %></div></div></div>
