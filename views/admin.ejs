<% layout('layout') -%>
<% const paymentLabels = {awaiting_payment:'Chờ thanh toán',pending_review:'Chờ kiểm tra',partial:'Đã nhận cọc',paid:'Đã trả đủ'}; const statusLabels = {pending:'Chờ xác nhận',confirmed:'Chờ phục vụ',completed:'Hoàn thành',cancelled:'Đã hủy',expired:'Quá hạn'}; const analyticsQuery = `period=${encodeURIComponent(analytics.range.period)}${analytics.range.fromInput ? `&from=${encodeURIComponent(analytics.range.fromInput)}` : ''}${analytics.range.toInput ? `&to=${encodeURIComponent(analytics.range.toInput)}` : ''}`; %>
<div class="dashboard-header"><h1><i class="fas fa-gauge-high"></i> Trung tâm quản trị</h1><p>Quản lý đơn, chuyến bay, tài xế, thanh toán và hội thoại.</p></div>
<div class="row g-3 mb-4"><% [[bookings.length,'Tổng đơn',''],[bookingGroups.pending.length,'Chờ xác nhận',''],[bookingGroups.serving.length,'Chờ phục vụ',''],[`${reviewStats.satisfaction}%`,'Khách hàng hài lòng','/reviews']].forEach(x => { %><div class="col-6 col-lg-3"><% if (x[2]) { %><a href="<%= x[2] %>" class="stat-card stat-card-link"><div class="stat-number"><%= x[0] %></div><div class="stat-label"><%= x[1] %> · <%= reviewStats.total %> đánh giá</div></a><% } else { %><div class="stat-card"><div class="stat-number"><%= x[0] %></div><div class="stat-label"><%= x[1] %></div></div><% } %></div><% }) %></div>

<nav class="admin-section-nav"><a href="#analytics"><i class="fa-solid fa-chart-line"></i> Phân tích</a><a href="#pending-bookings"><i class="fa-regular fa-hourglass-half"></i> Chờ xác nhận <b><%= bookingGroups.pending.length %></b></a><a href="#serving-bookings"><i class="fa-solid fa-car-side"></i> Chờ phục vụ <b><%= bookingGroups.serving.length %></b></a><a href="#completed-bookings"><i class="fa-solid fa-circle-check"></i> Đã hoàn thành <b><%= bookingGroups.completed.length %></b></a><a href="#reviews-management"><i class="fa-solid fa-star"></i> Đánh giá <b><%= reviews.length %></b></a><a href="#drivers">Tài xế</a><a href="#vehicles">Đội xe</a></nav>

<section class="analytics-panel" id="analytics">
    <header class="analytics-heading"><div><span class="analytics-eyebrow"><i class="fa-solid fa-chart-pie"></i> Báo cáo vận hành</span><h2>Phân tích số liệu chuyến xe</h2><p>Dữ liệu được lọc theo ngày chạy chuyến · <strong><%= analytics.range.label %></strong></p></div><div class="analytics-export-actions"><a href="/admin/analytics/export/xlsx?<%= analyticsQuery %>" class="export-btn export-excel"><i class="fa-solid fa-file-excel"></i><span>Excel</span></a><a href="/admin/analytics/export/csv?<%= analyticsQuery %>" class="export-btn export-csv"><i class="fa-solid fa-file-csv"></i><span>CSV</span></a><a href="/admin/analytics/export/json?<%= analyticsQuery %>" class="export-btn export-json"><i class="fa-solid fa-code"></i><span>JSON</span></a></div></header>
    <form class="analytics-filter" method="get" action="/admin#analytics">
        <label><span>Khoảng phân tích</span><select name="period" data-analytics-period><option value="30d" <%= analytics.range.period === '30d' ? 'selected' : '' %>>30 ngày</option><option value="90d" <%= analytics.range.period === '90d' ? 'selected' : '' %>>90 ngày</option><option value="365d" <%= analytics.range.period === '365d' ? 'selected' : '' %>>12 tháng</option><option value="all" <%= analytics.range.period === 'all' ? 'selected' : '' %>>Toàn bộ</option><option value="custom" <%= analytics.range.period === 'custom' ? 'selected' : '' %>>Tùy chọn</option></select></label>
        <div class="analytics-custom-dates <%= analytics.range.period === 'custom' ? '' : 'd-none' %>" data-analytics-custom><label><span>Từ ngày</span><input type="date" name="from" value="<%= analytics.range.fromInput %>"></label><label><span>Đến ngày</span><input type="date" name="to" value="<%= analytics.range.toInput %>"></label></div>
        <button type="submit"><i class="fa-solid fa-filter"></i> Áp dụng</button>
    </form>
    <div class="analytics-kpi-grid">
        <article class="analytics-kpi kpi-blue"><span><i class="fa-solid fa-calendar-check"></i></span><div><small>Số chuyến đặt</small><strong><%= analytics.metrics.totalBookings.toLocaleString('vi-VN') %></strong><em>Trong khoảng đã chọn</em></div></article>
        <article class="analytics-kpi kpi-green"><span><i class="fa-solid fa-circle-check"></i></span><div><small>Chuyến hoàn thành</small><strong><%= analytics.metrics.completedBookings.toLocaleString('vi-VN') %></strong><em><%= analytics.metrics.completionRate %>% tổng số chuyến</em></div></article>
        <article class="analytics-kpi kpi-gold"><span><i class="fa-solid fa-star"></i></span><div><small>Đánh giá khách hàng</small><strong><%= analytics.metrics.totalReviews.toLocaleString('vi-VN') %></strong><em><%= analytics.metrics.averageOverall.toFixed(1) %>/5 điểm tổng hợp</em></div></article>
        <article class="analytics-kpi kpi-rose"><span><i class="fa-solid fa-face-smile"></i></span><div><small>Mức hài lòng</small><strong><%= analytics.metrics.satisfaction %>%</strong><em>Chuyến <%= analytics.metrics.averageTrip.toFixed(1) %> · Tài xế <%= analytics.metrics.averageDriver.toFixed(1) %></em></div></article>
    </div>
    <div class="analytics-chart-grid">
        <article class="analytics-chart-card analytics-chart-wide"><header><div><h3>Xu hướng đặt và hoàn thành chuyến</h3><p>So sánh số đơn phát sinh theo từng giai đoạn</p></div><div class="chart-legend"><span class="legend-booked">Đã đặt</span><span class="legend-completed" data-i18n="status_completed">Hoàn thành</span></div></header><div class="analytics-canvas-wrap"><canvas data-analytics-chart="trend" aria-label="Biểu đồ xu hướng số chuyến" role="img"></canvas></div></article>
        <article class="analytics-chart-card"><header><div><h3>Cơ cấu trạng thái</h3><p>Tình trạng của toàn bộ đơn đã lọc</p></div></header><div class="analytics-canvas-wrap chart-square"><canvas data-analytics-chart="status" aria-label="Biểu đồ cơ cấu trạng thái" role="img"></canvas></div><div class="status-legend"><% analytics.status.forEach((item, index) => { %><span style="--legend-color:<%= ['#e5a527','#3878c7','#17a467','#df4261','#798396'][index] %>"><i></i><%= item.label %> <b><%= item.count %></b></span><% }) %></div></article>
        <article class="analytics-chart-card analytics-chart-wide"><header><div><h3>Số chuyến theo tài xế</h3><p>Xếp hạng theo số chuyến đã hoàn thành</p></div></header><div class="analytics-canvas-wrap driver-chart"><canvas data-analytics-chart="drivers" aria-label="Biểu đồ số chuyến của tài xế" role="img"></canvas></div></article>
        <article class="analytics-chart-card"><header><div><h3>Điểm đánh giá theo thời gian</h3><p>Điểm trung bình chuyến và tài xế</p></div></header><div class="analytics-canvas-wrap chart-square"><canvas data-analytics-chart="rating" aria-label="Biểu đồ điểm đánh giá" role="img"></canvas></div></article>
    </div>
    <div class="analytics-driver-table"><div class="analytics-table-title"><div><h3>Hiệu suất từng tài xế</h3><p>Theo dõi số chuyến, tỷ lệ hoàn thành và chất lượng phục vụ.</p></div><span><%= analytics.drivers.length %> tài xế</span></div><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Tài xế</th><th>Đã phân công</th><th>Hoàn thành</th><th>Đang phục vụ</th><th>Tỷ lệ hoàn thành</th><th>Đánh giá</th></tr></thead><tbody><% analytics.drivers.forEach(driver => { %><tr><td><strong><%= driver.name %></strong><small><%= driver.licensePlate || driver.phone || 'Chưa cập nhật thông tin' %></small></td><td><b><%= driver.assignedTrips %></b></td><td><b class="text-success"><%= driver.completedTrips %></b></td><td><%= driver.servingTrips %></td><td><div class="driver-progress"><span style="width:<%= driver.completionRate %>%"></span></div><small><%= driver.completionRate %>%</small></td><td><span class="driver-rating"><i class="fa-solid fa-star"></i> <%= driver.averageOverall.toFixed(1) %></span><small><%= driver.reviewCount %> đánh giá</small></td></tr><% }) %><% if (!analytics.drivers.length) { %><tr><td colspan="6" class="text-center text-muted py-4">Chưa có dữ liệu tài xế trong khoảng này.</td></tr><% } %></tbody></table></div></div>
</section>

<script id="adminAnalyticsData" type="application/json"><%- JSON.stringify({ metrics: analytics.metrics, status: analytics.status, trend: analytics.trend, drivers: analytics.drivers.slice(0, 10) }).replace(/</g, '\\u003c') %></script>
<script src="/js/admin-analytics.js" defer></script>

<% [['pending-bookings','Đơn chờ xác nhận','Kiểm tra thanh toán và xác nhận xe.',bookingGroups.pending,'warning'],['serving-bookings','Đơn chờ phục vụ','Xe đã khóa khỏi danh sách đặt mới cho đến khi chuyến hoàn tất.',bookingGroups.serving,'primary'],['completed-bookings','Đơn đã hoàn thành / lưu trữ','Đơn hoàn thành, đã hủy hoặc tự lưu trữ sau giờ đón 2 tiếng.',bookingGroups.completed,'success']].forEach(group => { %>
<section class="form-card admin-booking-section" id="<%= group[0] %>"><div class="card-header"><div class="d-flex justify-content-between align-items-center"><div><h4><%= group[1] %></h4><p><%= group[2] %></p></div><span class="admin-count"><%= group[3].length %></span></div></div><div class="card-body p-0">
<% if (!group[3].length) { %><div class="empty-admin-list"><i class="fa-solid fa-inbox"></i> Chưa có đơn trong nhóm này.</div><% } else { %><div class="table-responsive"><table class="table admin-booking-table align-middle mb-0"><thead><tr><th>Khách / lịch đón</th><th>Xe / tài xế / chuyến bay</th><th>Thanh toán</th><th>Trạng thái chuyến</th><th>Trao đổi</th></tr></thead><tbody>
<% group[3].forEach(b => { const vehicleName = b.vehicle?.name || b.vehicleSnapshot?.name || 'Xe đã xóa'; %><tr>
<td><strong><%= b.customerInfo.name %></strong><small class="d-block"><%= b.customerInfo.phone %></small><span class="booking-code">#<%= b._id.toString().slice(-8).toUpperCase() %></span><small class="d-block mt-1"><i class="fa-regular fa-calendar"></i> <%= new Date(b.bookingDate).toLocaleString('vi-VN') %></small></td>
<td><strong><%= vehicleName %></strong><small class="d-block"><%= b.customerInfo.pickupLocation %> → <%= b.customerInfo.dropoffLocation %></small><% const assignedDriver = b.assignedDriver || b.vehicle?.driver; %><small class="d-block mt-1"><i class="fa-solid fa-id-card"></i> <%= assignedDriver?.username || b.driverSnapshot?.name || 'Chưa gán tài xế' %><%= assignedDriver?.driverProfile?.licensePlate ? ` · ${assignedDriver.driverProfile.licensePlate}` : '' %></small>
<% if (b.tripType === 'airport-pickup' && b.customerInfo.flightNumber) { %><div class="flight-admin-box"><strong><i class="fa-solid fa-plane-arrival"></i> <%= b.customerInfo.flightNumber %></strong><span><%= b.flightTracking?.message || 'Chờ đồng bộ' %></span><% if (b.flightTracking?.estimatedArrival) { %><b>ETA: <%= new Date(b.flightTracking.estimatedArrival).toLocaleString('vi-VN') %></b><% } %><% if (b.flightTracking?.actualLanding) { %><b>Đáp thực tế: <%= new Date(b.flightTracking.actualLanding).toLocaleString('vi-VN') %></b><% } %><form method="post" action="/admin/bookings/<%= b._id %>/sync-flight"><button class="btn btn-sm btn-outline-primary"><i class="fa-solid fa-rotate"></i> Cập nhật FR24</button></form></div><% } %></td>
<td><span class="badge bg-secondary"><%= paymentLabels[b.payment.status] %></span><small class="d-block mt-1">Đã nhận: <b><%= b.payment.paidAmount.toLocaleString('vi-VN') %> / <%= b.totalPrice.toLocaleString('vi-VN') %>đ</b></small>
<% if (!['completed','cancelled','expired'].includes(b.status)) { %><form method="post" action="/admin/bookings/<%= b._id %>/payment" class="admin-inline-form mt-2"><input class="form-control form-control-sm" type="number" min="0" max="<%= b.totalPrice %>" name="paidAmount" value="<%= b.payment.status === 'partial' ? b.totalPrice : b.payment.requiredAmount %>" aria-label="Số tiền thực nhận"><button class="btn btn-sm btn-success">Xác nhận tiền</button></form><div class="current-selection"><i class="fa-solid fa-circle-check"></i> Đang ghi nhận: <strong><%= paymentLabels[b.payment.status] %></strong> · <%= b.payment.paidAmount.toLocaleString('vi-VN') %>đ</div><% } %></td>
<td><span class="status status-<%= b.status %>"><%= statusLabels[b.status] %></span><% if (!['completed','cancelled','expired'].includes(b.status)) { %><form method="post" action="/admin/bookings/<%= b._id %>/status" class="admin-inline-form mt-2"><select class="form-select form-select-sm" name="status"><% ['pending','confirmed','completed','cancelled'].forEach(s => { %><option value="<%= s %>" <%= b.status === s ? 'selected' : '' %>><%= statusLabels[s] %></option><% }) %></select><button class="btn btn-sm btn-dark">Lưu</button></form><div class="current-selection"><i class="fa-solid fa-location-dot"></i> Trạng thái hiện tại: <strong><%= statusLabels[b.status] %></strong></div><% } %></td>
<td><div class="d-grid gap-2"><a href="/bookings/<%= b._id %>" class="btn btn-sm btn-outline-dark">Xem chi tiết</a><% const chatUserId = String(b.user?._id || b.user); const unansweredCount = unansweredChatCounts[chatUserId] || 0; %><button type="button" class="btn btn-sm btn-primary admin-chat-button" data-chat-open data-chat-user="<%= chatUserId %>" data-chat-name="<%= b.customerInfo.name %>" data-chat-target="admin"><i class="fa-regular fa-comments"></i> Chat với khách <span class="unanswered-badge <%= unansweredCount ? '' : 'd-none' %>" data-chat-unanswered-user="<%= chatUserId %>" aria-label="<%= unansweredCount %> tin nhắn chưa phản hồi"><%= unansweredCount %></span></button><small class="unanswered-note <%= unansweredCount ? '' : 'd-none' %>" data-chat-unanswered-note="<%= chatUserId %>"><i class="fa-solid fa-circle-exclamation"></i> <b><%= unansweredCount %></b> tin khách đang chờ admin phản hồi</small></div></td>
</tr><% }) %></tbody></table></div><% } %></div></section>
<% }) %>

<section class="form-card" id="reviews-management"><div class="card-header"><div class="d-flex justify-content-between align-items-center"><div><h4><i class="fa-solid fa-star"></i> Đánh giá và mức độ hài lòng</h4><p>Tổng hợp trực tiếp từ điểm tài xế và chuyến đi của các đơn hoàn thành.</p></div><a class="btn btn-light" href="/reviews" target="_blank">Xem trang công khai</a></div></div><div class="card-body"><div class="admin-review-summary"><div class="satisfaction-ring" style="--score:<%= reviewStats.satisfaction %>"><div><strong><%= reviewStats.satisfaction %>%</strong><span>Hài lòng</span></div></div><div><h3><%= reviewStats.averageOverall.toFixed(1) %>/5 điểm tổng hợp</h3><p>Tài xế <b><%= reviewStats.averageDriver.toFixed(1) %>/5</b> · Chuyến đi <b><%= reviewStats.averageTrip.toFixed(1) %>/5</b> · <b><%= reviewStats.total %></b> đánh giá đang công khai.</p></div></div><div class="row g-3 mt-2"><% reviews.forEach(review => { %><div class="col-lg-6"><article class="admin-review-card"><div><strong><%= review.user?.username || 'Khách hàng' %></strong><span class="badge <%= review.isPublished ? 'bg-success' : 'bg-secondary' %>"><%= review.isPublished ? 'Đang hiển thị' : 'Đã ẩn' %></span></div><small><%= review.vehicleName %> · Tài xế <%= review.driverRating %>/5 · Chuyến <%= review.tripRating %>/5</small><p><%= review.comment %></p><form method="post" action="/admin/reviews/<%= review._id %>/toggle"><button class="btn btn-sm btn-outline-dark"><%= review.isPublished ? 'Ẩn đánh giá' : 'Hiện đánh giá' %></button></form></article></div><% }) %><% if (!reviews.length) { %><div class="col-12 text-center text-muted py-4">Chưa có đánh giá nào.</div><% } %></div></div></section>

<section class="form-card" id="drivers"><div class="card-header"><h4><i class="fa-solid fa-id-card"></i> Quản lý tài xế</h4><p>Tài xế đăng nhập bằng email và mật khẩu để xem chuyến, chat với khách.</p></div><div class="card-body"><form method="post" action="/admin/drivers" class="row g-2 admin-create-form"><div class="col-md-3"><input class="form-control" name="username" placeholder="Tên tài xế" required></div><div class="col-md-3"><input class="form-control" type="email" name="email" placeholder="Email đăng nhập" required></div><div class="col-md-2"><input class="form-control" name="phone" placeholder="Số điện thoại" required></div><div class="col-md-2"><input class="form-control" name="password" type="password" minlength="6" placeholder="Mật khẩu" required></div><div class="col-md-2"><input class="form-control" name="licensePlate" placeholder="Biển số xe"></div><div class="col-md-2"><input class="form-control" type="number" min="0" name="yearsExperience" placeholder="Năm kinh nghiệm"></div><div class="col-md-3"><input class="form-control" name="zalo" placeholder="Zalo"></div><div class="col-md-3"><input class="form-control" type="url" name="photo" placeholder="URL ảnh tài xế"></div><div class="col-md-4"><input class="form-control" name="note" placeholder="Ghi chú"><button class="btn btn-danger ms-2">Thêm tài xế</button></div></form>
<div class="row g-3 mt-3"><% drivers.forEach(driver => { %><div class="col-lg-6"><form method="post" action="/admin/drivers/<%= driver._id %>/edit" class="driver-admin-card"><div class="driver-card-head"><div class="driver-avatar"><% if (driver.driverProfile?.photo) { %><img src="<%= driver.driverProfile.photo %>" alt="<%= driver.username %>"><% } else { %><i class="fa-solid fa-user-tie"></i><% } %></div><div><strong><%= driver.username %></strong><small><%= driver.email %></small></div><span class="badge <%= driver.isActive ? 'bg-success' : 'bg-secondary' %>"><%= driver.isActive ? 'Hoạt động' : 'Tạm khóa' %></span></div><div class="row g-2"><div class="col-6"><input class="form-control form-control-sm" name="username" value="<%= driver.username %>" placeholder="Tên"></div><div class="col-6"><input class="form-control form-control-sm" name="phone" value="<%= driver.phone %>" placeholder="Điện thoại"></div><div class="col-6"><input class="form-control form-control-sm" name="licensePlate" value="<%= driver.driverProfile?.licensePlate || '' %>" placeholder="Biển số"></div><div class="col-6"><input class="form-control form-control-sm" type="number" min="0" name="yearsExperience" value="<%= driver.driverProfile?.yearsExperience || 0 %>" placeholder="Kinh nghiệm"></div><div class="col-6"><input class="form-control form-control-sm" name="zalo" value="<%= driver.driverProfile?.zalo || '' %>" placeholder="Zalo"></div><div class="col-6"><input class="form-control form-control-sm" type="url" name="photo" value="<%= driver.driverProfile?.photo || '' %>" placeholder="URL ảnh"></div><div class="col-6"><input class="form-control form-control-sm" name="password" type="password" placeholder="Mật khẩu mới (nếu đổi)"></div><div class="col-6"><select class="form-select form-select-sm" name="isActive"><option value="true" <%= driver.isActive ? 'selected' : '' %>>Hoạt động</option><option value="false" <%= !driver.isActive ? 'selected' : '' %>>Tạm khóa</option></select></div><div class="col-12"><input class="form-control form-control-sm" name="note" value="<%= driver.driverProfile?.note || '' %>" placeholder="Ghi chú"></div></div><button class="btn btn-sm btn-outline-primary mt-2">Lưu tài xế</button></form></div><% }) %></div></div></section>

<section class="form-card" id="contact-settings"><div class="card-header"><h4><i class="fa-solid fa-address-book"></i> Liên hệ, mạng xã hội và trả lời tự động</h4><p>Hiển thị trong khung chat và footer.</p></div><div class="card-body"><form method="post" action="/admin/contact-settings" class="row g-3"><% [['hotline','Hotline'],['zaloPhone','Số Zalo'],['zaloUrl','URL Zalo OA'],['supportHours','Giờ hỗ trợ'],['wechat','WeChat'],['whatsapp','WhatsApp'],['facebook','Facebook'],['tiktok','TikTok'],['line','LINE'],['viber','Viber'],['x','X'],['instagram','Instagram'],['telegram','Telegram']].forEach(field => { %><div class="col-md-3"><label class="form-label"><%= field[1] %></label><input class="form-control" name="<%= field[0] %>" value="<%= supportContact[field[0]] || '' %>"></div><% }) %><div class="col-md-3"><label class="form-label">Tự động trả lời khách</label><select class="form-select" name="autoReplyEnabled"><option value="true" <%= supportContact.autoReplyEnabled ? 'selected' : '' %>>Đang bật</option><option value="false" <%= !supportContact.autoReplyEnabled ? 'selected' : '' %>>Đang tắt</option></select></div><div class="col-12"><label class="form-label">Các câu trả lời mẫu <small class="text-muted">(mỗi dòng một câu, dùng {ten} để chèn tên khách; hệ thống chọn ngẫu nhiên)</small></label><textarea class="form-control auto-reply-templates" name="autoReplyTemplates" rows="10"><%= (supportContact.autoReplyTemplates || []).join('\n') %></textarea><div class="current-selection"><i class="fa-solid fa-shuffle"></i> Hệ thống chỉ tự trả lời nếu admin chưa phản hồi và tối đa một câu trong mỗi 10 phút cho cùng khách.</div></div><div class="col-12"><button class="btn btn-danger">Lưu thông tin và câu trả lời</button></div></form></div></section>

<section class="form-card" id="payment-settings"><div class="card-header"><h4>Tài khoản nhận thanh toán VietQR</h4></div><div class="card-body"><form method="post" action="/admin/payment-settings" class="row g-3"><div class="col-md-3"><label class="form-label">Mã ngân hàng</label><input class="form-control" name="bankId" value="<%= bank.bankId || '' %>" required></div><div class="col-md-3"><label class="form-label">Tên ngân hàng</label><input class="form-control" name="bankName" value="<%= bank.bankName || '' %>" required></div><div class="col-md-3"><label class="form-label">Số tài khoản</label><input class="form-control" name="accountNo" value="<%= bank.accountNo || '' %>" required></div><div class="col-md-3"><label class="form-label">Chủ tài khoản</label><input class="form-control" name="accountName" value="<%= bank.accountName || '' %>" required></div><div class="col-12"><button class="btn btn-danger">Lưu tài khoản</button></div></form></div></section>

<section class="form-card" id="image-library"><div class="card-header"><h4><i class="fas fa-images"></i> Thư viện ảnh xe</h4></div><div class="card-body"><form method="post" action="/admin/images" enctype="multipart/form-data" class="row g-2 align-items-end mb-4"><div class="col-md-9"><label class="form-label">Ảnh JPG, PNG, WEBP hoặc GIF, tối đa 5 MB</label><input class="form-control" type="file" name="vehicleImage" accept="image/jpeg,image/png,image/webp,image/gif" required></div><div class="col-md-3"><button class="btn btn-danger w-100">Tải ảnh lên</button></div></form><div class="row g-3"><% imageAssets.forEach(image => { %><div class="col-6 col-md-3"><div class="image-library-card"><img src="<%= image.url %>" alt="<%= image.originalName %>"><div class="p-2"><small class="d-block text-truncate"><%= image.originalName %></small><form method="post" action="/admin/images/<%= image._id %>/delete" onsubmit="return confirm('Xóa ảnh này?')"><button class="btn btn-sm btn-outline-danger w-100 mt-2">Xóa ảnh</button></form></div></div></div><% }) %></div></div></section>

<section class="form-card" id="vehicles"><div class="card-header"><h4><i class="fa-solid fa-car"></i> Quản lý đội xe</h4><p>Gán tài xế cho xe để mở chat sau khi đơn được xác nhận.</p></div><div class="card-body"><form method="post" action="/admin/vehicles" enctype="multipart/form-data" class="row g-2 mb-4 admin-create-form"><div class="col-md-3"><input class="form-control" name="name" placeholder="Tên xe" required></div><div class="col-md-2"><select class="form-select" name="type"><% vehicleTypes.forEach(t => { %><option value="<%= t %>"><%= t %></option><% }) %></select></div><div class="col-md-2"><input class="form-control" type="number" min="0" name="price" placeholder="Giá/lượt" required></div><div class="col-md-2"><input class="form-control" type="number" min="1" name="capacity" placeholder="Số khách" required></div><div class="col-md-3"><input class="form-control" type="number" min="0" name="luggageCapacity" placeholder="Hành lý"></div><div class="col-md-4"><select class="form-select" name="driverId"><option value="">-- Chưa gán tài xế --</option><% drivers.filter(d => d.isActive).forEach(d => { %><option value="<%= d._id %>"><%= d.username %> · <%= d.driverProfile?.licensePlate || 'chưa có biển số' %></option><% }) %></select></div><div class="col-md-4"><select class="form-select" name="imageAssetId" id="vehicleImageAsset"><option value="">-- Chọn ảnh thư viện --</option><% imageAssets.forEach(image => { %><option value="<%= image._id %>" data-image-url="<%= image.url %>"><%= image.originalName %></option><% }) %></select></div><div class="col-md-4"><input class="form-control" type="url" name="image" placeholder="Hoặc URL ảnh"></div><div class="col-12"><input class="form-control" name="description" placeholder="Mô tả xe"><img id="vehicleImagePreview" class="admin-image-preview d-none mt-2" alt="Xem trước"></div><%- include("vehicle-photo-fields", { photoVehicle: null, imageAssets }) %><div class="col-12"><button class="btn btn-danger">Thêm xe</button></div></form>
<div class="row g-3"><% vehicles.forEach(v => { %><div class="col-md-6 col-xl-4"><div class="vehicle-admin-card"><img class="vehicle-admin-thumb" src="<%= v.images[0] || '/images/default-car.jpg' %>" alt="<%= v.name %>"><div><strong><%= v.name %></strong><small><%= v.type %> · <%= v.price.toLocaleString('vi-VN') %>đ</small><small><i class="fa-solid fa-user-tie"></i> <%= v.driver?.username || 'Chưa gán tài xế' %></small><span class="badge <%= v.isAvailable ? 'bg-success' : 'bg-secondary' %>"><%= v.isAvailable ? 'Đang hoạt động' : 'Đã ẩn' %></span></div><div class="vehicle-admin-actions"><a class="btn btn-sm btn-primary" href="/admin/vehicles/<%= v._id %>/edit">Chỉnh sửa</a><form method="post" action="/admin/vehicles/<%= v._id %>/toggle"><button class="btn btn-sm btn-outline-dark"><%= v.isAvailable ? 'Ẩn' : 'Hiện' %></button></form><form method="post" action="/admin/vehicles/<%= v._id %>/delete" onsubmit="return confirm('Xóa vĩnh viễn xe này?')"><button class="btn btn-sm btn-outline-danger">Xóa</button></form></div></div></div><% }) %></div></div></section>
