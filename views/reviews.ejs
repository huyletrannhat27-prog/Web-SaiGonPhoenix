<% layout('layout') -%>
<section class="reviews-page" data-i18n-scope>
    <header class="reviews-hero"><div><span class="section-kicker" data-i18n="customer_reviews">KHÁCH HÀNG NÓI GÌ</span><h1 data-i18n="real_reviews">Đánh giá từ những chuyến đi thực tế</h1><p data-i18n="review_transparency">Mỗi nhận xét đều gắn với một đơn đã hoàn thành.</p></div><div class="satisfaction-ring" style="--score:<%= reviewStats.satisfaction %>"><div><strong><%= reviewStats.satisfaction %>%</strong><span data-i18n="satisfaction">Hài lòng</span></div></div></header>
    <div class="review-summary-grid"><article><strong><%= reviewStats.averageOverall.toFixed(1) %>/5</strong><span data-i18n="overall_rating">Điểm tổng hợp</span></article><article><strong><%= reviewStats.averageDriver.toFixed(1) %>/5</strong><span data-i18n="driver_review">Đánh giá tài xế</span></article><article><strong><%= reviewStats.averageTrip.toFixed(1) %>/5</strong><span data-i18n="trip_rating">Đánh giá chuyến đi</span></article><article><strong><%= reviewStats.total %></strong><span data-i18n="verified_reviews">Đánh giá đã xác thực</span></article></div>
    <% if (!reviews.length) { %><div class="empty-state review-empty"><i class="fa-regular fa-star"></i><h3 data-i18n="no_reviews">Chưa có đánh giá</h3><p data-i18n="first_review">Các đánh giá từ chuyến hoàn thành sẽ xuất hiện tại đây.</p></div><% } else { %>
    <div class="review-list"><% reviews.forEach(review => { %><article class="public-review-card"><div class="review-card-head"><div class="reviewer-avatar"><%= (review.user?.username || 'K').charAt(0).toUpperCase() %></div><div><strong><%= review.user?.username || 'Khách hàng' %></strong><small><i class="fa-solid fa-circle-check"></i> <span data-i18n="verified_trip">Chuyến đi đã xác thực</span> · <%= new Date(review.createdAt).toLocaleDateString('vi-VN') %></small></div><div class="review-overall"><i class="fa-solid fa-star"></i><%= ((review.tripRating + review.driverRating) / 2).toFixed(1) %></div></div><div class="review-score-row"><span><span data-i18n="driver">Tài xế</span> <b><%= review.driverRating %>/5</b></span><span><span data-i18n="trip">Chuyến đi</span> <b><%= review.tripRating %>/5</b></span><span><i class="fa-solid fa-car-side"></i> <%= review.vehicleName %></span></div><p class="review-comment"><%= review.comment %></p><% if (review.images?.length) { %><div class="review-photo-grid"><% review.images.forEach(image => { %><a href="<%= image %>" target="_blank" rel="noopener"><img src="<%= image %>" alt="Ảnh đánh giá chuyến đi" loading="lazy"></a><% }) %></div><% } %><small class="driver-reviewed"><i class="fa-solid fa-user-tie"></i> <%= review.driverName %></small></article><% }) %></div>
    <% } %>
</section>
