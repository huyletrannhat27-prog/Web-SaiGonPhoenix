<% layout('layout') -%>
<div class="auth-single fade-in"><section class="auth-card modern-auth-card"><div class="card-body">
    <% if (!sent) { %><div class="auth-heading"><span class="auth-icon"><i class="fa-solid fa-key"></i></span><h2>Quên mật khẩu?</h2><p>Nhập email đã đăng ký, chúng tôi sẽ gửi liên kết giúp bạn tạo mật khẩu mới.</p></div>
    <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
    <form action="/forgot-password" method="post"><label class="modern-field"><span>Email tài khoản</span><div><i class="fa-regular fa-envelope"></i><input type="email" name="email" value="<%= form.email || '' %>" placeholder="ban@example.com" autocomplete="email" required></div></label><button class="btn-submit" type="submit">Gửi liên kết khôi phục <i class="fa-solid fa-paper-plane"></i></button></form>
    <% } else { %><div class="auth-success"><span><i class="fa-regular fa-envelope-open"></i></span><h2>Hãy kiểm tra email</h2><p>Nếu <strong><%= form.email %></strong> tồn tại trong hệ thống, bạn sẽ nhận được liên kết đặt lại mật khẩu có hiệu lực trong 15 phút.</p><small>Chưa thấy email? Kiểm tra thư rác hoặc thử gửi lại sau ít phút.</small></div>
    <% if (developmentResetUrl) { %><div class="dev-reset-box"><strong>Chế độ phát triển</strong><span>SMTP chưa cấu hình. Dùng liên kết dưới đây để kiểm thử:</span><a href="<%= developmentResetUrl %>">Mở trang đặt lại mật khẩu</a></div><% } %>
    <% } %>
    <div class="auth-switch"><a href="/login"><i class="fa-solid fa-arrow-left me-1"></i> Quay lại đăng nhập</a></div>
</div></section></div>
