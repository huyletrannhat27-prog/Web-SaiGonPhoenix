<% layout('layout') -%>
<div class="dashboard-header"><h1><i class="fa-solid fa-steering-wheel"></i> Chuyến được phân công</h1><p>Xin chào <%= session.username %>. Chỉ hiển thị các chuyến đã được admin xác nhận.</p></div>
<div class="row g-3"><% if (!bookings.length) { %><div class="col-12"><div class="empty-state"><i class="fa-solid fa-route"></i><p>Hiện chưa có chuyến nào cần phục vụ.</p></div></div><% } %><% bookings.forEach(b => { %><div class="col-lg-6"><article class="driver-trip-card"><div class="d-flex justify-content-between"><span class="booking-code">#<%= b._id.toString().slice(-8).toUpperCase() %></span><strong><%= new Date(b.bookingDate).toLocaleString('vi-VN') %></strong></div><h3><%= b.user?.username || b.customerInfo.name %> · <%= b.customerInfo.phone %></h3><p><i class="fa-solid fa-location-dot"></i> <%= b.customerInfo.pickupLocation %> → <%= b.customerInfo.dropoffLocation %></p><p><i class="fa-solid fa-plane"></i> <%= b.customerInfo.flightNumber || 'Không có mã chuyến bay' %></p><button class="btn btn-primary" data-chat-open data-chat-booking="<%= b._id %>" data-chat-name="<%= b.customerInfo.name %>" data-chat-target="driver"><i class="fa-regular fa-comments"></i> Chat với khách</button><a class="btn btn-outline-dark" href="/bookings/<%= b._id %>">Xem chi tiết</a></article></div><% }) %></div>
