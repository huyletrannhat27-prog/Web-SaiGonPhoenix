<% layout('layout') -%>
<div class="form-card fade-in"><div class="card-header"><h4><i class="fas fa-car-side"></i> Chọn xe và đặt chuyến</h4><p>Giá hiển thị là giá dự kiến cho một lượt</p></div><div class="card-body">
<% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
<form method="post" action="/booking"><h5 class="mb-3">1. Chọn chiếc xe bạn muốn đi</h5><div class="row g-3 mb-4 vehicle-picker">
<% vehicles.forEach((vehicle, index) => { %><div class="col-md-6 col-lg-3"><label class="vehicle-option h-100"><input type="radio" name="vehicleId" value="<%= vehicle._id %>" <%= form.vehicleId == vehicle._id || (!form.vehicleId && index === 0) ? 'checked' : '' %> required><span class="vehicle-card d-block h-100"><img src="<%= vehicle.images[0] || '/images/default-car.jpg' %>" alt="<%= vehicle.name %>"><span class="d-block p-3"><strong class="d-block"><%= vehicle.name %></strong><small><%= vehicle.type %> · <%= vehicle.capacity %> khách · <%= vehicle.luggageCapacity %> hành lý</small><b class="d-block mt-2 text-danger"><%= vehicle.price.toLocaleString('vi-VN') %>đ/lượt</b></span></span></label></div><% }) %></div>
<h5 class="mb-3">2. Thông tin chuyến đi</h5><div class="row g-3">
<div class="col-md-6"><label class="form-label">Hình thức</label><select class="form-select" name="tripType"><option value="airport-pickup">Đón từ sân bay</option><option value="airport-dropoff">Tiễn ra sân bay</option></select></div>
<div class="col-md-6"><label class="form-label">Sân bay *</label><select class="form-select" name="airport" required><option value="">Chọn sân bay</option><% ['Sân bay Tân Sơn Nhất (SGN)','Sân bay Nội Bài (HAN)','Sân bay Cam Ranh (CXR)','Sân bay Đà Nẵng (DAD)','Sân bay Cần Thơ (VCA)','Sân bay Phú Quốc (PQC)'].forEach(a => { %><option <%= form.airport === a ? 'selected' : '' %>><%= a %></option><% }) %></select></div>
<div class="col-md-6"><label class="form-label">Họ tên *</label><input class="form-control" name="customerName" value="<%= form.customerName || user.username %>" required></div><div class="col-md-6"><label class="form-label">Số điện thoại *</label><input class="form-control" type="tel" name="phone" value="<%= form.phone || user.phone %>" required></div>
<div class="col-md-6"><label class="form-label">Ngày giờ đón *</label><input class="form-control" type="datetime-local" name="bookingDate" value="<%= form.bookingDate || '' %>" required></div><div class="col-md-3"><label class="form-label">Số khách *</label><input class="form-control" type="number" min="1" name="passengerCount" value="<%= form.passengerCount || 1 %>" required></div><div class="col-md-3"><label class="form-label">Số hành lý</label><input class="form-control" type="number" min="0" name="luggageCount" value="<%= form.luggageCount || 0 %>"></div>
<div class="col-md-6"><label class="form-label">Điểm đón *</label><input class="form-control" name="pickupLocation" value="<%= form.pickupLocation || '' %>" required></div><div class="col-md-6"><label class="form-label">Điểm trả *</label><input class="form-control" name="dropoffLocation" value="<%= form.dropoffLocation || '' %>" required></div><div class="col-md-4"><label class="form-label">Mã chuyến bay</label><input class="form-control" name="flightNumber" value="<%= form.flightNumber || '' %>"></div><div class="col-md-8"><label class="form-label">Ghi chú</label><input class="form-control" maxlength="500" name="note" value="<%= form.note || '' %>"></div>
</div><div class="payment-choice mt-4"><h5>3. Chọn mức thanh toán</h5><p class="text-muted small">Bạn cần chuyển khoản trước để giữ xe. Số tiền chính xác và mã QR sẽ xuất hiện sau khi tạo đơn.</p><div class="row g-3"><div class="col-md-6"><label class="payment-option"><input type="radio" name="paymentOption" value="deposit" <%= form.paymentOption !== 'full' ? 'checked' : '' %> required><span><strong>Đặt cọc 30%</strong><small>Thanh toán 70% còn lại khi gặp tài xế hoặc chuyển khoản sau.</small></span></label></div><div class="col-md-6"><label class="payment-option"><input type="radio" name="paymentOption" value="full" <%= form.paymentOption === 'full' ? 'checked' : '' %>><span><strong>Thanh toán toàn bộ 100%</strong><small>Hoàn tất tiền chuyến ngay bằng chuyển khoản ngân hàng.</small></span></label></div></div></div>
<button class="btn-submit mt-4" type="submit"><i class="fas fa-check"></i> Tạo đơn và lấy mã thanh toán</button></form></div></div>
