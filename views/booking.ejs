<% layout('layout') -%>
<% const airports = ['Sân bay Tân Sơn Nhất (SGN)','Sân bay Nội Bài (HAN)','Sân bay Cam Ranh (CXR)','Sân bay Đà Nẵng (DAD)','Sân bay Cần Thơ (VCA)','Sân bay Phú Quốc (PQC)']; %>
<header class="booking-header fade-in"><div><span class="section-kicker">ĐẶT XE TRỰC TUYẾN</span><h1>Chuyến sân bay nhẹ nhàng bắt đầu từ đây</h1><p>Hoàn tất thông tin, chọn xe và nhận mã thanh toán trong vài phút.</p></div><div class="booking-trust"><span><i class="fa-solid fa-shield-halved"></i> Bảo mật thông tin</span><span><i class="fa-solid fa-bolt"></i> Xác nhận nhanh</span></div></header>

<div class="booking-stepper"><div class="active"><span>1</span><strong>Hành trình</strong></div><i></i><div class="active"><span>2</span><strong>Chọn xe</strong></div><i></i><div class="active"><span>3</span><strong>Xác nhận</strong></div></div>

<% if (error) { %><div class="alert alert-danger booking-error"><i class="fa-solid fa-circle-exclamation me-2"></i><%= error %></div><% } %>
<form method="post" action="/booking" id="bookingForm" class="booking-layout">
    <input type="hidden" name="uiLanguage" value="vi">
    <div class="booking-main">
        <section class="booking-section-card">
            <div class="booking-section-title"><span>1</span><div><h2>Hành trình của bạn</h2><p>Cho chúng tôi biết nơi và thời gian cần đón</p></div></div>
            <div class="trip-type-picker">
                <label><input type="radio" name="tripType" value="airport-pickup" <%= form.tripType !== 'airport-dropoff' ? 'checked' : '' %>><span><i class="fa-solid fa-plane-arrival"></i><strong>Đón từ sân bay</strong><small>Tài xế đón khi bạn hạ cánh</small></span></label>
                <label><input type="radio" name="tripType" value="airport-dropoff" <%= form.tripType === 'airport-dropoff' ? 'checked' : '' %>><span><i class="fa-solid fa-plane-departure"></i><strong>Tiễn ra sân bay</strong><small>Đón tận nơi, đến sân bay đúng giờ</small></span></label>
            </div>
            <div class="row g-3 mt-1">
                <div class="col-lg-7"><label class="modern-field"><span>Sân bay <b>*</b></span><div><i class="fa-solid fa-location-dot"></i><select name="airport" required><option value="">Chọn sân bay</option><% airports.forEach(a => { %><option value="<%= a %>" <%= form.airport === a ? 'selected' : '' %>><%= a %></option><% }) %></select></div></label></div>
                <div class="col-lg-5"><label class="modern-field"><span>Ngày giờ đón <b>*</b></span><div><i class="fa-regular fa-calendar"></i><input type="datetime-local" name="bookingDate" value="<%= form.bookingDate || '' %>" required></div></label><div class="quick-time-list"><button type="button" data-quick-time="3">Sau 3 giờ</button><button type="button" data-quick-time="tomorrow-8">Sáng mai</button><button type="button" data-quick-time="tomorrow-18">Tối mai</button></div><div id="availabilityMessage" class="availability-message" aria-live="polite"></div></div>
                <div class="col-md-6"><label class="modern-field"><span>Điểm đón <b>*</b></span><div><i class="fa-solid fa-location-arrow"></i><input name="pickupLocation" id="pickupLocation" value="<%= form.pickupLocation || '' %>" placeholder="Nhập địa chỉ đón" autocomplete="street-address" required></div></label></div>
                <div class="col-md-6 position-relative"><button class="route-swap" type="button" id="routeSwap" aria-label="Đổi điểm đón và điểm trả"><i class="fa-solid fa-right-left"></i></button><label class="modern-field"><span>Điểm trả <b>*</b></span><div><i class="fa-solid fa-location-dot"></i><input name="dropoffLocation" id="dropoffLocation" value="<%= form.dropoffLocation || '' %>" placeholder="Nhập địa chỉ trả" autocomplete="street-address" required></div></label></div>
            </div>
        </section>

        <section class="booking-section-card">
            <div class="booking-section-title"><span>2</span><div><h2>Chọn xe phù hợp</h2><p>Hệ thống tự ẩn xe bận theo thời gian bạn chọn</p></div></div>
            <% if (!vehicles.length) { %><div class="empty-state"><i class="fa-solid fa-car-burst"></i><p>Hiện chưa có xe hoạt động. Vui lòng chat Zalo với admin để được hỗ trợ.</p></div><% } else { %>
            <div class="vehicle-category-tabs" data-vehicle-filters><button type="button" class="active" data-filter="all">Tất cả</button><button type="button" data-filter="4-cho">4 chỗ</button><button type="button" data-filter="7-cho">7 chỗ</button><button type="button" data-filter="9-cho">9 chỗ</button><button type="button" data-filter="16-cho">16 chỗ</button><button type="button" data-filter="26-cho">26 chỗ</button><button type="button" data-filter="limousine">Limousine</button><button type="button" data-filter="other">Xe đoàn</button></div>
            <div class="vehicle-picker modern-vehicle-picker"><% vehicles.forEach((vehicle, index) => { %>
                <% const category = ['9 cho vip','limousine'].includes(vehicle.type) ? 'limousine' : ['4 cho','7 cho','9 cho','16 cho','26 cho'].includes(vehicle.type) ? vehicle.type.replace(' ','-') : 'other'; %><label class="vehicle-option" data-vehicle-option data-vehicle-category="<%= category %>">
                    <input type="radio" name="vehicleId" value="<%= vehicle._id %>" data-name="<%= vehicle.name %>" data-price="<%= vehicle.price %>" data-capacity="<%= vehicle.capacity %>" data-luggage="<%= vehicle.luggageCapacity %>" data-image="<%= vehicle.images[0] || '/images/default-car.jpg' %>" <%= form.vehicleId == vehicle._id || (!form.vehicleId && index === 0) ? 'checked' : '' %> required>
                    <span class="vehicle-card"><span class="vehicle-check"><i class="fa-solid fa-check"></i></span><span class="vehicle-image-wrap"><img src="<%= vehicle.images[0] || '/images/default-car.jpg' %>" alt="<%= vehicle.name %>" loading="lazy"><em><%= vehicle.type %></em></span><span class="vehicle-content"><strong><%= vehicle.name %></strong><small><i class="fa-solid fa-user-group"></i> <%= vehicle.capacity %> khách <i class="fa-solid fa-suitcase-rolling ms-2"></i> <%= vehicle.luggageCapacity %> kiện</small><b><%= vehicle.price.toLocaleString('vi-VN') %>đ <small>/ lượt</small></b></span></span>
                </label>
            <% }) %></div><div class="no-vehicle-message d-none" id="noVehicleMessage"><i class="fa-regular fa-face-frown"></i><strong>Không còn xe trống trong giờ này</strong><span>Hãy thử đổi giờ đón hoặc chat với admin để được hỗ trợ.</span></div>
            <% } %>
        </section>

        <section class="booking-section-card">
            <div class="booking-section-title"><span>3</span><div><h2>Thông tin hành khách</h2><p>Admin sẽ dùng thông tin này để xác nhận chuyến</p></div></div>
            <div class="row g-3">
                <div class="col-md-6"><label class="modern-field"><span>Họ và tên <b>*</b></span><div><i class="fa-regular fa-user"></i><input name="customerName" value="<%= form.customerName || user.username %>" autocomplete="name" required></div></label></div>
                <div class="col-md-6"><label class="modern-field"><span>Số điện thoại <b>*</b></span><div><i class="fa-solid fa-phone"></i><input type="tel" name="phone" value="<%= form.phone || user.phone %>" autocomplete="tel" required></div></label></div>
                <div class="col-md-4"><label class="modern-field"><span>Số khách <b>*</b></span><div class="quantity-control"><button type="button" data-quantity-minus aria-label="Giảm"><i class="fa-solid fa-minus"></i></button><input type="number" min="1" name="passengerCount" value="<%= form.passengerCount || 1 %>" required><button type="button" data-quantity-plus aria-label="Tăng"><i class="fa-solid fa-plus"></i></button></div></label></div>
                <div class="col-md-4"><label class="modern-field"><span>Số hành lý</span><div class="quantity-control"><button type="button" data-quantity-minus aria-label="Giảm"><i class="fa-solid fa-minus"></i></button><input type="number" min="0" name="luggageCount" value="<%= form.luggageCount || 0 %>"><button type="button" data-quantity-plus aria-label="Tăng"><i class="fa-solid fa-plus"></i></button></div></label></div>
                <div class="col-md-4"><label class="modern-field"><span>Mã chuyến bay</span><div><i class="fa-solid fa-plane"></i><input name="flightNumber" value="<%= form.flightNumber || '' %>" placeholder="VD: VN123"></div></label></div>
                <div class="col-12"><label class="modern-field"><span>Ghi chú cho tài xế</span><div><i class="fa-regular fa-message"></i><textarea maxlength="500" name="note" rows="3" placeholder="Ghế trẻ em, bảng tên đón khách, hành lý đặc biệt..."><%= form.note || '' %></textarea></div></label></div>
            </div>
        </section>

        <section class="booking-section-card">
            <div class="booking-section-title"><span>4</span><div><h2>Chọn mức thanh toán</h2><p>Quét VietQR sau khi đơn được tạo</p></div></div>
            <div class="payment-options-modern">
                <label class="payment-option"><input type="radio" name="paymentOption" value="deposit" <%= form.paymentOption !== 'full' ? 'checked' : '' %> required><span><i class="fa-solid fa-coins"></i><div><strong>Đặt cọc 30%</strong><small>Giữ xe trước, thanh toán phần còn lại sau</small><b data-deposit-amount>—</b></div><em><i class="fa-solid fa-check"></i></em></span></label>
                <label class="payment-option"><input type="radio" name="paymentOption" value="full" <%= form.paymentOption === 'full' ? 'checked' : '' %>><span><i class="fa-solid fa-circle-check"></i><div><strong>Thanh toán toàn bộ</strong><small>Hoàn tất 100% chi phí chuyến ngay</small><b data-full-amount>—</b></div><em><i class="fa-solid fa-check"></i></em></span></label>
            </div>
        </section>
    </div>

    <aside class="booking-summary">
        <div class="summary-card"><div class="summary-head"><div><span>TÓM TẮT CHUYẾN</span><h3>Lựa chọn của bạn</h3></div><i class="fa-solid fa-receipt"></i></div>
            <div class="summary-vehicle"><img data-summary-image src="" alt="Xe đã chọn"><div><small>Xe đã chọn</small><strong data-summary-name>Đang chọn xe...</strong><span data-summary-capacity></span></div></div>
            <div class="summary-route"><div><i class="fa-solid fa-circle-dot"></i><span><small>Điểm đón</small><strong data-summary-pickup>Chưa nhập</strong></span></div><i class="summary-line"></i><div><i class="fa-solid fa-location-dot"></i><span><small>Điểm trả</small><strong data-summary-dropoff>Chưa nhập</strong></span></div></div>
            <div class="summary-info"><span><i class="fa-regular fa-calendar"></i><b data-summary-time>Chưa chọn thời gian</b></span><span><i class="fa-solid fa-plane"></i><b data-summary-airport>Chưa chọn sân bay</b></span></div>
            <div class="summary-price"><span><small>Giá chuyến dự kiến</small><em>Đã gồm phí dịch vụ</em></span><strong data-summary-price>0đ</strong></div>
            <div class="summary-due"><span>Cần thanh toán lúc này</span><strong data-summary-due>0đ</strong></div>
            <button class="btn-submit" type="submit" <%= vehicles.length ? '' : 'disabled' %>><span>Xác nhận đặt xe</span><i class="fa-solid fa-arrow-right"></i></button>
            <p class="summary-note"><i class="fa-solid fa-lock"></i> Thông tin được bảo mật và chỉ dùng cho chuyến đi.</p>
        </div>
        <div class="need-help"><span><i class="fa-solid fa-headset"></i></span><div><strong>Cần hỗ trợ chọn xe?</strong><small>Admin sẵn sàng tư vấn qua Zalo</small></div><a href="<%= supportContact.zaloUrl %>" target="_blank" rel="noopener">Chat ngay</a></div>
    </aside>
</form>
