<dialog class="vehicle-lightbox" data-vehicle-gallery aria-labelledby="vehicle-gallery-title" data-no-translate>
    <header class="vehicle-lightbox-header"><div><span class="gallery-eyebrow" data-gallery-text="vg_eyebrow">KHÁM PHÁ CHI TIẾT</span><h2 id="vehicle-gallery-title" data-gallery-name></h2></div><button type="button" class="gallery-icon" data-gallery-close aria-label="Đóng">×</button></header>
    <div class="gallery-tabs" role="group" aria-label="Nhóm ảnh"><button type="button" data-gallery-mode="exterior" aria-pressed="true">Ngoại thất</button><button type="button" data-gallery-mode="interior" aria-pressed="false">Nội thất</button><button type="button" data-gallery-mode="spin" aria-pressed="false">Xoay 360°</button></div>
    <div class="gallery-stage" data-gallery-stage tabindex="0" role="group" aria-label="Ảnh xe. Dùng phím mũi tên để chuyển ảnh.">
        <img data-gallery-image alt="" draggable="false" hidden>
        <div class="gallery-stage-status" data-gallery-status role="status" aria-live="polite"></div>
        <button type="button" class="gallery-arrow gallery-prev" data-gallery-prev aria-label="Ảnh trước" hidden>‹</button><button type="button" class="gallery-arrow gallery-next" data-gallery-next aria-label="Ảnh tiếp theo" hidden>›</button>
        <span class="gallery-counter" data-gallery-counter hidden></span>
    </div>
    <div class="gallery-controls"><p data-gallery-hint></p><button type="button" class="gallery-motion" data-gallery-motion aria-pressed="false" hidden></button></div>
    <div class="gallery-thumbnails" data-gallery-thumbnails aria-label="Chọn ảnh"></div>
    <footer class="vehicle-lightbox-footer"><span data-gallery-specs></span><a class="btn btn-danger" data-gallery-book href="/booking">Đặt xe này</a></footer>
</dialog>
