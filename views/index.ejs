<% layout('layout') -%>
<section class="hero-section text-center fade-in"><div class="container"><h1><i class="fas fa-plane-arrival"></i> SaiGonPhoenix</h1><p class="lead">Đặt xe sân bay rõ giá · đúng giờ · hỗ trợ 24/7</p><a href="/booking" class="btn btn-hero"><i class="fas fa-calendar-check"></i> Chọn xe ngay</a></div></section>
<div class="row g-4 mt-2"><% vehicles.forEach(vehicle => { %><div class="col-md-6 col-lg-3"><div class="vehicle-card h-100"><img src="<%= vehicle.images[0] || '/images/default-car.jpg' %>" alt="<%= vehicle.name %>"><div class="p-3"><span class="badge bg-danger"><%= vehicle.type %></span><h5 class="mt-2"><%= vehicle.name %></h5><p class="text-muted small"><%= vehicle.description %></p><div class="d-flex justify-content-between"><strong><%= vehicle.price.toLocaleString('vi-VN') %>đ</strong><span><i class="fas fa-user"></i> <%= vehicle.capacity %></span></div></div></div></div><% }) %></div>
<div class="row g-4 mt-4"><% [['fa-clock','Đúng giờ','Theo dõi lịch bay và chủ động thời gian đón.'],['fa-shield-halved','An toàn','Xe kiểm tra định kỳ, tài xế chuyên nghiệp.'],['fa-headset','Hỗ trợ 24/7','Luôn sẵn sàng hỗ trợ thay đổi lịch trình.']].forEach(x => { %><div class="col-md-4"><div class="feature-card"><div class="icon-wrapper"><i class="fas <%= x[0] %>"></i></div><h5><%= x[1] %></h5><p><%= x[2] %></p></div></div><% }) %></div>
