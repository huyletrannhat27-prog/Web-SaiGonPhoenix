<% layout('layout') -%>
<section id="homeBanners" class="carousel slide home-carousel fade-in" data-bs-ride="carousel" data-bs-interval="5200" data-bs-pause="hover">
    <div class="carousel-indicators"><button type="button" data-bs-target="#homeBanners" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Banner 1"></button><button type="button" data-bs-target="#homeBanners" data-bs-slide-to="1" aria-label="Banner 2"></button><button type="button" data-bs-target="#homeBanners" data-bs-slide-to="2" aria-label="Banner 3"></button></div>
    <div class="carousel-inner">
        <div class="carousel-item active banner-slide banner-airport">
            <div class="banner-overlay"></div><div class="banner-content"><span class="eyebrow"><i class="fa-solid fa-plane-arrival"></i> <span data-i18n="airport_transfer_247">Đưa đón sân bay 24/7</span></span><h1><span data-i18n="landing_peacefully">Hạ cánh an tâm,</span><br><span data-i18n="car_waiting">đã có xe chờ.</span></h1><p data-i18n="book_in_minutes">Đặt trước trong vài phút, biết giá ngay và theo dõi chuyến đi dễ dàng.</p><div class="d-flex flex-wrap gap-2"><a href="/booking" class="btn btn-hero"><span data-i18n="book_now">Đặt xe ngay</span> <i class="fa-solid fa-arrow-right"></i></a><a href="tel:<%= supportContact.hotline.replace(/\s/g, '') %>" class="btn btn-hero-outline"><i class="fa-solid fa-phone"></i> <%= supportContact.hotline %></a></div></div>
        </div>
        <div class="carousel-item banner-slide banner-family">
            <div class="banner-overlay"></div><div class="banner-content"><span class="eyebrow"><i class="fa-solid fa-people-group"></i> <span data-i18n="many_vehicle_choices">Nhiều lựa chọn xe</span></span><h2><span data-i18n="solo_or_group">Đi một mình hay cả đoàn,</span><br><span data-i18n="right_vehicle">luôn có xe phù hợp.</span></h2><p data-i18n="fleet_range">Từ sedan 4 chỗ đến xe đoàn 45 chỗ, khoang hành lý được hiển thị rõ ràng.</p><a href="#featuredVehicles" class="btn btn-hero"><span data-i18n="view_fleet">Xem đội xe</span> <i class="fa-solid fa-arrow-down"></i></a></div>
        </div>
        <div class="carousel-item banner-slide banner-business">
            <div class="banner-overlay"></div><div class="banner-content"><span class="eyebrow"><i class="fa-solid fa-gem"></i> <span data-i18n="polished_trip">Chuyến đi chỉn chu</span></span><h2><span data-i18n="punctual_transparent">Đúng giờ, minh bạch,</span><br><span data-i18n="attentive_support">hỗ trợ tận tâm.</span></h2><p data-i18n="fast_confirm_vietqr">Xác nhận nhanh, thanh toán VietQR tiện lợi và admin sẵn sàng hỗ trợ qua Zalo.</p><a href="<%= supportContact.zaloUrl %>" target="_blank" rel="noopener" class="btn btn-hero"><span data-i18n="chat_admin">Chat với admin</span> <i class="fa-solid fa-comment-dots"></i></a></div>
        </div>
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#homeBanners" data-bs-slide="prev"><span class="carousel-control-prev-icon"></span><span class="visually-hidden">Trước</span></button>
    <button class="carousel-control-next" type="button" data-bs-target="#homeBanners" data-bs-slide="next"><span class="carousel-control-next-icon"></span><span class="visually-hidden">Sau</span></button>
</section>

<section class="quick-booking-panel slide-up" aria-label="Tìm chuyến xe">
    <div class="quick-booking-title"><span><i class="fa-solid fa-route"></i></span><div><strong data-i18n="your_trip">Chuyến đi của bạn</strong><small data-i18n="quick_next_step">Chọn nhanh, hoàn tất ở bước tiếp theo</small></div></div>
    <form action="/booking" method="get" class="quick-booking-grid">
        <label class="smart-field"><span data-i18n="trip_type">Loại chuyến</span><div><i class="fa-solid fa-plane"></i><select name="tripType"><option value="airport-pickup" data-i18n="airport_pickup">Đón từ sân bay</option><option value="airport-dropoff" data-i18n="airport_dropoff">Tiễn ra sân bay</option></select></div></label>
        <label class="smart-field"><span data-i18n="airport">Sân bay</span><div><i class="fa-solid fa-location-dot"></i><select name="airport" required><option value="" data-i18n="select_airport">Chọn sân bay</option><% ['Sân bay Tân Sơn Nhất (SGN)','Sân bay Nội Bài (HAN)','Sân bay Cam Ranh (CXR)','Sân bay Đà Nẵng (DAD)','Sân bay Cần Thơ (VCA)','Sân bay Phú Quốc (PQC)'].forEach(a => { %><option><%= a %></option><% }) %></select></div></label>
        <label class="smart-field"><span data-i18n="pickup_datetime">Ngày giờ đón</span><div><i class="fa-regular fa-calendar"></i><input type="datetime-local" name="bookingDate" required></div></label>
        <button class="quick-search-btn" type="submit"><i class="fa-solid fa-magnifying-glass"></i> <span data-i18n="search_vehicle">Tìm xe</span></button>
    </form>
</section>

<section class="trust-strip"><div><strong>10K+</strong><span data-i18n="safe_trips">Chuyến an toàn</span></div><a class="trust-review-link" href="/reviews" aria-label="Đọc đánh giá khách hàng"><strong><%= reviewStats.satisfaction %>%</strong><span><span data-i18n="satisfied_customers">Khách hàng hài lòng</span> · <%= reviewStats.total %> <span data-i18n="reviews_lower">đánh giá</span></span><small><span data-i18n="click_read_reviews">Nhấn để đọc nhận xét</span> <i class="fa-solid fa-arrow-right"></i></small></a><div><strong>24/7</strong><span data-i18n="always_ready">Luôn sẵn sàng</span></div><div><strong>6</strong><span data-i18n="airports_served">Sân bay phục vụ</span></div></section>

<section id="featuredVehicles" class="section-block">
    <div class="section-heading"><div><span class="section-kicker" data-i18n="featured_fleet">ĐỘI XE NỔI BẬT</span><h2 data-i18n="choose_trip_space">Chọn không gian vừa vặn cho hành trình</h2></div><a href="/booking" class="text-link"><span data-i18n="view_book_vehicle">Xem và đặt xe</span> <i class="fa-solid fa-arrow-right"></i></a></div>
    <div class="vehicle-category-tabs home-vehicle-tabs" data-vehicle-filters><button type="button" class="active" data-filter="all">Tất cả xe</button><button type="button" data-filter="4-cho">4 chỗ</button><button type="button" data-filter="7-cho">7 chỗ</button><button type="button" data-filter="9-cho">9 chỗ</button><button type="button" data-filter="16-cho">16 chỗ</button><button type="button" data-filter="26-cho">26 chỗ</button><button type="button" data-filter="limousine">Limousine</button><button type="button" data-filter="other">Xe đoàn</button></div>
    <% if (!vehicles.length) { %><div class="empty-state"><i class="fa-solid fa-car"></i><p>Đội xe đang được cập nhật. Vui lòng liên hệ admin.</p></div><% } else { %>
    <div class="row g-4"><% vehicles.forEach(vehicle => { const category = ['9 cho vip','limousine'].includes(vehicle.type) ? 'limousine' : ['4 cho','7 cho','9 cho','16 cho','26 cho'].includes(vehicle.type) ? vehicle.type.replace(' ','-') : 'other'; %><div class="col-md-6 col-xl-3" data-vehicle-card data-vehicle-category="<%= category %>"><article class="vehicle-card vehicle-showcase h-100"><div class="vehicle-image-wrap"><img src="<%= vehicle.images[0] || '/images/default-car.jpg' %>" alt="<%= vehicle.name %>" loading="lazy"><span class="vehicle-badge"><%= vehicle.type %></span></div><div class="vehicle-content"><h3><%= vehicle.name %></h3><p><%= vehicle.description %></p><div class="vehicle-meta"><span><i class="fa-solid fa-user-group"></i> <%= vehicle.capacity %> khách</span><span><i class="fa-solid fa-suitcase-rolling"></i> <%= vehicle.luggageCapacity %> kiện</span></div><div class="vehicle-footer"><div><small>Từ</small><strong><%= vehicle.price.toLocaleString('vi-VN') %>đ</strong></div><a href="/booking?vehicleId=<%= vehicle._id %>" aria-label="Đặt <%= vehicle.name %>"><i class="fa-solid fa-arrow-right"></i></a></div></div></article></div><% }) %></div>
    <% } %>
</section>

<section class="experience-section">
    <div><span class="section-kicker">TRẢI NGHIỆM KHÁC BIỆT</span><h2>Mọi chi tiết đều hướng đến một chuyến đi nhẹ nhàng</h2><p>Không còn phải gọi nhiều nơi để hỏi giá. Bạn chủ động chọn xe, thời gian, mức thanh toán và nhận xác nhận ngay trên một giao diện.</p><a href="/about" class="text-link text-white">Tìm hiểu về chúng tôi <i class="fa-solid fa-arrow-right"></i></a></div>
    <div class="experience-grid"><article><i class="fa-regular fa-clock"></i><strong>Đúng giờ</strong><span>Chủ động theo lịch bay</span></article><article><i class="fa-solid fa-shield-halved"></i><strong>An toàn</strong><span>Xe và tài xế được kiểm tra</span></article><article><i class="fa-solid fa-receipt"></i><strong>Rõ chi phí</strong><span>Biết giá trước khi đặt</span></article><article><i class="fa-solid fa-comments"></i><strong>Hỗ trợ nhanh</strong><span>Chat trực tiếp qua Zalo</span></article></div>
</section>
