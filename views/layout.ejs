<!doctype html>
<html lang="vi" data-theme="light" data-theme-preference="auto">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="SaiGonPhoenix - Đặt xe đưa đón sân bay nhanh chóng, minh bạch và an toàn 24/7.">
    <meta name="theme-color" content="#121b35">
    <script>(function(){try{var preference=localStorage.getItem('sgp-theme')||'auto';var hour=new Date().getHours();var theme=preference==='auto'?(hour>=6&&hour<18?'light':'dark'):preference;document.documentElement.dataset.theme=theme;document.documentElement.dataset.themePreference=preference;}catch(e){}})();</script>
    <title><%= title %> | SaiGonPhoenix</title>
    <link rel="icon" type="image/png" href="/images/saigon-phoenix-logo-square-original.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="topbar">
        <div class="container d-flex justify-content-between align-items-center gap-3">
            <span class="d-none d-lg-inline"><i class="fa-solid fa-shield-heart"></i> <span data-i18n="safe_booking">Đặt xe an tâm · Giá rõ ràng · Xác nhận nhanh</span></span>
            <div class="topbar-tools ms-auto">
                <label class="display-control" title="Ngôn ngữ" data-i18n-title="language_label"><i class="fa-solid fa-language"></i><select data-language-select aria-label="Chọn ngôn ngữ" data-i18n-aria-label="choose_language"><option value="vi">Tiếng Việt</option><option value="en">English</option><option value="zh-CN">中文</option><option value="ko">한국어</option><option value="ja">日本語</option><option value="th">ไทย</option><option value="fr">Français</option><option value="de">Deutsch</option><option value="es">Español</option><option value="pt">Português</option><option value="ru">Русский</option><option value="it">Italiano</option><option value="nl">Nederlands</option><option value="ar">العربية</option><option value="hi">हिन्दी</option><option value="id">Bahasa Indonesia</option><option value="ms">Bahasa Melayu</option><option value="tl">Filipino</option><option value="km">ខ្មែរ</option><option value="lo">ລາວ</option></select></label>
                <label class="display-control" title="Giao diện" data-i18n-title="theme_label"><i class="fa-solid fa-circle-half-stroke"></i><select data-theme-select aria-label="Chọn giao diện" data-i18n-aria-label="choose_theme"><option value="auto">Tự động</option><option value="light">Sáng</option><option value="dark">Tối</option></select></label>
                <span class="d-none d-md-inline"><i class="fa-solid fa-headset"></i> <span data-i18n="support_hours"><%= supportContact.supportHours %></span>: <a href="tel:<%= supportContact.hotline.replace(/\s/g, '') %>"><%= supportContact.hotline %></a></span>
            </div>
        </div>
    </div>
    <nav class="navbar navbar-expand-lg navbar-dark navbar-custom">
        <div class="container">
            <a class="navbar-brand brand-logo-link" href="/" aria-label="SaiGonPhoenix - Trang chủ"><img class="brand-logo" src="/images/saigon-phoenix-logo-square-original.png" alt="SaiGonPhoenix Airport Pickup & Car Rental"></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav" aria-controls="nav" aria-expanded="false" aria-label="Mở menu" data-i18n-aria-label="open_menu"><span class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse" id="nav">
                <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-1">
                    <li><a class="nav-link" href="/"><i class="fa-solid fa-house"></i><span data-i18n="home">Trang chủ</span></a></li>
                    <li><a class="nav-link" href="/booking"><i class="fa-solid fa-car-side"></i><span data-i18n="book_car">Đặt xe</span></a></li>
                    <li><a class="nav-link" href="/reviews"><i class="fa-solid fa-star"></i><span data-i18n="reviews">Đánh giá</span></a></li>
                    <li><a class="nav-link" href="/about"><i class="fa-regular fa-circle-question"></i><span data-i18n="about">Giới thiệu</span></a></li>
                    <% if (session.userId) { %>
                        <li><a class="nav-link" href="<%= session.role === 'admin' ? '/admin' : session.role === 'driver' ? '/driver' : '/dashboard' %>"><i class="fa-regular fa-user"></i><span data-i18n="<%= session.role === 'admin' ? 'admin' : session.role === 'driver' ? 'driver_trips' : 'my_trips' %>"><%= session.role === 'admin' ? 'Quản trị' : session.role === 'driver' ? 'Chuyến tài xế' : 'Chuyến của tôi' %></span></a></li>
                        <li><form method="post" action="/logout"><button class="nav-link nav-logout border-0 bg-transparent" type="submit"><i class="fa-solid fa-arrow-right-from-bracket"></i><span data-i18n="logout">Đăng xuất</span></button></form></li>
                    <% } else { %>
                        <li><a class="nav-link btn-nav-login" href="/login" data-i18n="login">Đăng nhập</a></li>
                        <li><a class="nav-link btn-nav-register ms-lg-1" href="/register" data-i18n="register">Đăng ký</a></li>
                    <% } %>
                </ul>
            </div>
        </div>
    </nav>

    <div class="flash-stack container" aria-live="polite">
        <% (flash.success || []).forEach(message => { const rawMessage = String(message); const bookingSuccess = rawMessage.startsWith('[BOOKING_SUCCESS]'); const cleanMessage = bookingSuccess ? rawMessage.slice(17) : rawMessage; %>
            <% if (bookingSuccess) { %>
                <div class="booking-success-toast" data-booking-success-toast role="status">
                    <div class="booking-success-icon"><i class="fa-solid fa-check"></i></div>
                    <div class="booking-success-copy"><span class="booking-success-label">SaiGonPhoenix</span><strong><%= cleanMessage %></strong></div>
                    <button type="button" class="booking-success-close" data-booking-success-close aria-label="Close"><i class="fa-solid fa-xmark"></i></button>
                    <div class="booking-success-progress"></div>
                </div>
            <% } else { %><div class="alert alert-success alert-dismissible fade show"><i class="fa-solid fa-circle-check me-2"></i><%= cleanMessage %><button class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button></div><% } %>
        <% }) %>
        <% (flash.error || []).forEach(message => { %><div class="alert alert-danger alert-dismissible fade show"><i class="fa-solid fa-circle-exclamation me-2"></i><%= message %><button class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button></div><% }) %>
    </div>

    <main><div class="container py-4"><%- body %></div></main>

    <footer class="footer-custom">
        <div class="container">
            <div class="row g-4 align-items-start">
                <div class="col-lg-4"><img class="footer-logo" src="/images/saigon-phoenix-logo-square-original.png" alt="SaiGonPhoenix Airport Pickup & Car Rental"><p class="footer-description" data-i18n="footer_description">Đồng hành cùng bạn trên mọi hành trình sân bay với đội xe chất lượng, tài xế chuyên nghiệp và hỗ trợ tận tâm.</p></div>
                <div class="col-6 col-lg-2"><h6 data-i18n="explore">Khám phá</h6><a href="/" data-i18n="home">Trang chủ</a><a href="/booking" data-i18n="book_car">Đặt xe</a><a href="/reviews" data-i18n="reviews">Đánh giá</a><a href="/about" data-i18n="about">Giới thiệu</a></div>
                <div class="col-6 col-lg-2"><h6 data-i18n="support">Hỗ trợ</h6><a href="tel:<%= supportContact.hotline.replace(/\s/g, '') %>">Hotline</a><a href="<%= supportContact.zaloUrl %>" target="_blank" rel="noopener">Chat Zalo</a><a href="/forgot-password" data-i18n="forgot_password">Quên mật khẩu</a></div>
                <div class="col-lg-4"><h6 data-i18n="contact_social">Liên hệ & mạng xã hội</h6><p class="mb-2"><i class="fa-solid fa-phone me-2"></i><%= supportContact.hotline %> · <span data-i18n="support_hours"><%= supportContact.supportHours %></span></p><div class="footer-social-grid"><% [['wechat','WeChat','fa-brands fa-weixin'],['whatsapp','WhatsApp','fa-brands fa-whatsapp'],['facebook','Facebook','fa-brands fa-facebook'],['tiktok','TikTok','fa-brands fa-tiktok'],['line','LINE','fa-brands fa-line'],['viber','Viber','fa-brands fa-viber'],['x','X','fa-brands fa-x-twitter'],['instagram','Instagram','fa-brands fa-instagram'],['telegram','Telegram','fa-brands fa-telegram']].forEach(social => { if (supportContact[social[0]]) { %><span title="<%= supportContact[social[0]] %>"><i class="<%= social[2] %>"></i><%= social[1] %>: <%= supportContact[social[0]] %></span><% } }) %></div></div>
            </div>
            <div class="footer-bottom">© <%= new Date().getFullYear() %> SaiGonPhoenix · <span data-i18n="airport_transfer_service">Dịch vụ đưa đón sân bay</span></div>
        </div>
    </footer>

    <% if (session.userId) { %>
    <div class="chat-widget" data-chat-widget data-chat-role="<%= session.role %>" data-chat-default-target="<%= session.role === 'user' ? 'admin' : '' %>">
        <section class="chat-panel" id="chatPanel" aria-hidden="true">
            <header class="chat-header" data-chat-drag-handle><div class="chat-avatar"><i class="fa-solid fa-comments"></i></div><div><strong data-chat-title><%= session.role === 'user' ? 'Admin SaiGonPhoenix' : 'Tin nhắn' %></strong><small><span></span> <span data-i18n="chat_saved">Hội thoại được lưu tự động</span></small></div><div class="chat-window-actions"><button type="button" data-chat-fullscreen title="Toàn màn hình"><i class="fa-solid fa-expand"></i></button><button type="button" data-chat-close title="Thu nhỏ"><i class="fa-solid fa-minus"></i></button></div></header>
            <div class="chat-empty" data-chat-empty><i class="fa-regular fa-message"></i><strong data-i18n="<%= session.role === 'user' ? 'start_admin_chat' : 'select_chat' %>"><%= session.role === 'user' ? 'Bắt đầu trò chuyện với admin' : 'Chọn nút Chat tại một đơn để mở hội thoại' %></strong><span data-i18n="chat_persist">Tin nhắn, ảnh và video sẽ còn nguyên khi bạn mở lại.</span></div>
            <div class="chat-messages" data-chat-messages aria-live="polite"></div>
            <div class="chat-upload-preview d-none" data-chat-preview></div>
            <form class="chat-compose" data-chat-form enctype="multipart/form-data"><input type="hidden" name="target"><input type="hidden" name="userId"><input type="hidden" name="bookingId"><input type="hidden" name="language" value="vi"><label title="Gửi ảnh hoặc video"><i class="fa-solid fa-camera"></i><input type="file" name="media" accept="image/*,video/mp4,video/webm,video/quicktime"></label><textarea name="text" rows="1" maxlength="2000" placeholder="Nhập tin nhắn..." data-i18n-placeholder="chat_placeholder"></textarea><button type="submit" title="Gửi"><i class="fa-solid fa-paper-plane"></i></button></form>
            <footer class="chat-footer"><span><i class="fa-solid fa-lock"></i> <span data-i18n="direct_chat">Chat trực tiếp, không chuyển trang</span></span><% if (supportContact.zaloUrl && supportContact.zaloUrl !== '#') { %><a href="<%= supportContact.zaloUrl %>" target="_blank" rel="noopener" data-i18n="zalo_backup">Zalo dự phòng</a><% } %></footer>
        </section>
        <button class="chat-fab" type="button" data-chat-toggle aria-controls="chatPanel" aria-expanded="false"><span class="support-pulse"></span><i class="fa-solid fa-comments"></i><span data-i18n="<%= session.role === 'user' ? 'chat_admin' : 'messages' %>"><%= session.role === 'user' ? 'Chat với admin' : 'Tin nhắn' %></span><% if (session.role === 'admin') { const initialUnansweredTotal = typeof unansweredChatTotal !== 'undefined' ? unansweredChatTotal : 0; %><b class="chat-total-badge <%= initialUnansweredTotal ? '' : 'd-none' %>" data-chat-unanswered-total><%= initialUnansweredTotal %></b><% } %></button>
    </div>
    <% } %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/localization.js"></script>
    <script src="/js/script.js"></script>
</body>
</html>
