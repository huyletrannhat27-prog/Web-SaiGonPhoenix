<!doctype html><html lang="vi"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title><%= title %> | SaiGonPhoenix</title>
<link rel="icon" type="image/png" href="/images/saigon-phoenix-logo.png">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
<link rel="stylesheet" href="/css/style.css"></head><body>
<nav class="navbar navbar-expand-lg navbar-dark navbar-custom"><div class="container">
<a class="navbar-brand brand-logo-link" href="/" aria-label="SaiGon Phoenix - Trang chủ"><img class="brand-logo" src="/images/saigon-phoenix-logo.png" alt="SaiGon Phoenix Airport Pickup & Car Rental"></a>
<button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#nav"><span class="navbar-toggler-icon"></span></button>
<div class="collapse navbar-collapse" id="nav"><ul class="navbar-nav ms-auto align-items-lg-center">
<li><a class="nav-link" href="/">Trang chủ</a></li><li><a class="nav-link" href="/booking">Đặt xe</a></li><li><a class="nav-link" href="/about">Giới thiệu</a></li>
<% if (session.userId) { %><li><a class="nav-link" href="<%= session.role === 'admin' ? '/admin' : '/dashboard' %>"><%= session.role === 'admin' ? 'Quản trị' : 'Đơn của tôi' %></a></li><li><form method="post" action="/logout"><button class="nav-link border-0 bg-transparent" type="submit">Đăng xuất</button></form></li>
<% } else { %><li><a class="nav-link btn-nav-login" href="/login">Đăng nhập</a></li><li><a class="nav-link btn-nav-register ms-lg-2" href="/register">Đăng ký</a></li><% } %>
</ul></div></div></nav>
<div class="container mt-3"><% (flash.success || []).forEach(message => { %><div class="alert alert-success alert-dismissible fade show"><%= message %><button class="btn-close" data-bs-dismiss="alert"></button></div><% }) %><% (flash.error || []).forEach(message => { %><div class="alert alert-danger alert-dismissible fade show"><%= message %><button class="btn-close" data-bs-dismiss="alert"></button></div><% }) %></div>
<main><div class="container py-4"><%- body %></div></main>
<footer class="footer-custom"><div class="container text-center"><p class="mb-1"><strong>SaiGonPhoenix</strong> · Đón tiễn sân bay an toàn 24/7</p><small>Hotline: 0900 000 000 · support@saigonphoenix.vn</small></div></footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script><script src="/js/script.js"></script></body></html>
