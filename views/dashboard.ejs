<% layout('layout') -%>
<div class="dashboard-header"><div class="d-md-flex justify-content-between align-items-center"><div><h1><span data-i18n="hello">Xin chào</span>, <%= session.username %></h1><p data-i18n="manage_your_trips">Theo dõi và quản lý các chuyến xe của bạn.</p></div><a class="btn btn-hero mt-3 mt-md-0" href="/booking" data-i18n="book_new_trip">Đặt chuyến mới</a></div></div>
<div class="row g-3 mb-4"><% [['total_trips',stats.total,'Tổng chuyến'],['waiting',stats.pending,'Đang chờ'],['confirmed',stats.confirmed,'Đã xác nhận'],['completed',stats.completed,'Hoàn thành']].forEach(x => { %><div class="col-6 col-md-3"><div class="stat-card"><div class="stat-number"><%= x[1] %></div><div class="stat-label" data-i18n="<%= x[0] %>"><%= x[2] %></div></div></div><% }) %></div>
<div class="form-card"><div class="card-header"><h4 data-i18n="booking_history">Lịch sử đặt xe</h4></div><div class="card-body p-0"><% if (!bookings.length) { %><div class="text-center p-5 text-muted"><span data-i18n="no_bookings">Bạn chưa có chuyến xe nào.</span> <a href="/booking" data-i18n="book_now">Đặt xe ngay</a></div><% } else { %><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th data-i18n="booking_code">Mã đơn</th><th data-i18n="vehicle">Xe</th><th data-i18n="pickup_date">Ngày đón</th><th data-i18n="price">Giá</th><th data-i18n="status">Trạng thái</th><th></th></tr></thead><tbody><% bookings.forEach(b => { %><tr><td>#<%= b._id.toString().slice(-8).toUpperCase() %></td><td><%= b.vehicle?.name || b.vehicleSnapshot?.name || 'Xe đã xóa' %></td><td><%= new Date(b.bookingDate).toLocaleString('vi-VN') %></td><td><%= b.totalPrice.toLocaleString('vi-VN') %>đ</td><td><span class="status status-<%= b.status %>" data-i18n="status_<%= b.status %>"><%= ({pending:'Chờ xác nhận',confirmed:'Chờ phục vụ',completed:'Hoàn thành',cancelled:'Đã hủy',expired:'Quá hạn'})[b.status] %></span></td><td><div class="d-flex gap-2"><a class="btn btn-sm btn-outline-dark" href="/bookings/<%= b._id %>" data-i18n="details">Chi tiết</a><% if (b.status === 'completed') { %><a class="btn btn-sm <%= reviewedBookingIds.has(String(b._id)) ? 'btn-outline-success' : 'btn-warning' %>" href="/bookings/<%= b._id %>/review"><i class="fa-solid fa-star"></i> <span data-i18n="<%= reviewedBookingIds.has(String(b._id)) ? 'reviewed' : 'review_action' %>"><%= reviewedBookingIds.has(String(b._id)) ? 'Đã đánh giá' : 'Đánh giá' %></span></a><% } %></div></td></tr><% }) %></tbody></table></div><% } %></div></div>
