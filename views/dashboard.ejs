<% layout('layout') -%>
<div class="dashboard-header"><div class="d-md-flex justify-content-between align-items-center"><div><h1>Xin chào, <%= session.username %></h1><p>Theo dõi và quản lý các chuyến xe của bạn.</p></div><a class="btn btn-hero mt-3 mt-md-0" href="/booking">Đặt chuyến mới</a></div></div>
<div class="row g-3 mb-4"><% [['Tổng chuyến',stats.total],['Đang chờ',stats.pending],['Đã xác nhận',stats.confirmed],['Hoàn thành',stats.completed]].forEach(x => { %><div class="col-6 col-md-3"><div class="stat-card"><div class="stat-number"><%= x[1] %></div><div class="stat-label"><%= x[0] %></div></div></div><% }) %></div>
<div class="form-card"><div class="card-header"><h4>Lịch sử đặt xe</h4></div><div class="card-body p-0"><% if (!bookings.length) { %><div class="text-center p-5 text-muted">Bạn chưa có chuyến xe nào. <a href="/booking">Đặt xe ngay</a></div><% } else { %><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Mã đơn</th><th>Xe</th><th>Ngày đón</th><th>Giá</th><th>Trạng thái</th><th></th></tr></thead><tbody><% bookings.forEach(b => { %><tr><td>#<%= b._id.toString().slice(-8).toUpperCase() %></td><td><%= b.vehicle?.name || 'Xe đã xóa' %></td><td><%= new Date(b.bookingDate).toLocaleString('vi-VN') %></td><td><%= b.totalPrice.toLocaleString('vi-VN') %>đ</td><td><span class="status status-<%= b.status %>"><%= ({pending:'Chờ xác nhận',confirmed:'Đã xác nhận',completed:'Hoàn thành',cancelled:'Đã hủy'})[b.status] %></span></td><td><a class="btn btn-sm btn-outline-dark" href="/bookings/<%= b._id %>">Chi tiết</a></td></tr><% }) %></tbody></table></div><% } %></div></div>
