<% layout('layout') -%>
<div class="auth-single fade-in"><section class="auth-card modern-auth-card"><div class="card-body">
    <div class="auth-heading"><span class="auth-icon"><i class="fa-solid fa-shield-keyhole"></i></span><h2>Tạo mật khẩu mới</h2><p>Chọn mật khẩu dễ nhớ với bạn và khó đoán với người khác.</p></div>
    <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
    <% if (token) { %><form action="/reset-password/<%= token %>" method="post"><label class="modern-field"><span>Mật khẩu mới <small class="password-strength"></small></span><div><i class="fa-solid fa-lock"></i><input type="password" name="password" minlength="6" placeholder="Tối thiểu 6 ký tự" autocomplete="new-password" required><button type="button" class="password-toggle" data-password-toggle><i class="fa-regular fa-eye"></i></button></div></label><label class="modern-field"><span>Xác nhận mật khẩu <small class="confirm-message"></small></span><div><i class="fa-solid fa-shield-halved"></i><input type="password" name="confirmPassword" minlength="6" placeholder="Nhập lại mật khẩu" autocomplete="new-password" required><button type="button" class="password-toggle" data-password-toggle><i class="fa-regular fa-eye"></i></button></div></label><button class="btn-submit" type="submit">Cập nhật mật khẩu <i class="fa-solid fa-check"></i></button></form><% } else { %><a class="btn-submit" href="/forgot-password">Yêu cầu liên kết mới</a><% } %>
    <div class="auth-switch"><a href="/login"><i class="fa-solid fa-arrow-left me-1"></i> Quay lại đăng nhập</a></div>
</div></section></div>
